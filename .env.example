# =============================================================
# Copia este ficheiro para .env e preenche os valores reais
# cp .env.example .env
# O .env nunca deve ser commitado no git!
# =============================================================

# ─────────────────────────────────────────────
# MySQL — base de dados do Portal .NET MVC
# ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DB=dec_educativa
MYSQL_USER=dec_portal
MYSQL_PASSWORD=change_me_portal

# ─────────────────────────────────────────────
# MySQL — base de dados do Django API
# ─────────────────────────────────────────────
MYSQL_FINANCEIRA_USER=dec_django
MYSQL_FINANCEIRA_PASSWORD=change_me_django

# ─────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────
DJANGO_SECRET_KEY=change_me_to_a_random_50_char_secret_key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
@model dotnet_mvc.ViewModels.Admin.UsersIndexViewModel

@{
    ViewData["Title"] = "Utilizadores";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Gerir utilizadores</h1>
        <p class="page-header__subtitle">@Model.TotalCount utilizador@(Model.TotalCount == 1 ? "" : "es") no total.</p>
    </div>
</div>

<div class="grid grid--4 mb-8">
    <div class="stat-card">
        <div class="stat-card__icon">👥</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Total</div>
            <div class="stat-card__value">@Model.TotalCount</div>
            <div class="stat-card__hint">Registados</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--success">✓</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Ativos</div>
            <div class="stat-card__value">@Model.ActiveCount</div>
            <div class="stat-card__hint">Com acesso ativo</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--info">🎓</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Alunos</div>
            <div class="stat-card__value">@Model.StudentCount</div>
            <div class="stat-card__hint">Papel de aluno</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon">📋</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Professores</div>
            <div class="stat-card__value">@Model.ProfessorCount</div>
            <div class="stat-card__hint">Papel de professor</div>
        </div>
    </div>
</div>

@* ===== Filtros ===== *@
<form method="get" asp-controller="Admin" asp-action="Users" class="filters-bar">
    <input type="search"
           name="search"
           value="@Model.Search"
           class="form-control"
           placeholder="Pesquisar por nome ou email…"
           style="max-width: 280px; padding: var(--space-2) var(--space-3);" />

    <select class="filters-bar__select" name="role" onchange="this.form.submit()">
        <option value="" selected="@(Model.RoleFilter == null)">Todos os papéis</option>
        <option value="Student" selected="@(Model.RoleFilter == "Student")">Aluno</option>
        <option value="Professor" selected="@(Model.RoleFilter == "Professor")">Professor</option>
        <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Administrador</option>
    </select>

    <select class="filters-bar__select" name="status" onchange="this.form.submit()">
        <option value="" selected="@(Model.StatusFilter == null)">Todos os estados</option>
        <option value="active" selected="@(Model.StatusFilter == "active")">Ativos</option>
        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inativos</option>
    </select>

    <button type="submit" class="btn btn--outline btn--sm">Pesquisar</button>

    @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.RoleFilter != null || Model.StatusFilter != null)
    {
        <a class="btn btn--ghost btn--sm" asp-controller="Admin" asp-action="Users">Limpar</a>
    }
</form>

@if (Model.Users.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state__icon">👤</div>
        <div class="empty-state__title">Sem utilizadores</div>
        <p class="empty-state__text">
            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.RoleFilter != null || Model.StatusFilter != null)
            {
                <span>Nenhum utilizador corresponde aos filtros aplicados.</span>
            }
            else
            {
                <span>Ainda não existem utilizadores registados.</span>
            }
        </p>
    </div>
}
else
{
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Utilizador</th>
                        <th>Email</th>
                        <th>Papel</th>
                        <th>Estado</th>
                        <th>Último acesso</th>
                        <th style="text-align: right;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: var(--space-3);">
                                    <div class="sidebar-avatar" style="width: 2rem; height: 2rem; font-size: 0.85rem; border-radius: 0.375rem;">
                                        @u.Name[0]
                                    </div>
                                    <strong>@u.Name</strong>
                                </div>
                            </td>
                            <td><span class="text-muted">@u.Email</span></td>
                            <td>
                                @switch (u.Role)
                                {
                                    case "Professor":
                                        <span class="badge badge--info">@u.RoleLabel</span>
                                        break;
                                    case "Admin":
                                        <span class="badge badge--danger">@u.RoleLabel</span>
                                        break;
                                    default:
                                        <span class="badge badge--neutral">@u.RoleLabel</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge badge--success badge--dot">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge badge--danger badge--dot">Inativo</span>
                                }
                            </td>
                            <td>
                                <span class="text-muted">
                                    @(u.LastLoginAtUtc.HasValue
                                        ? u.LastLoginAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        : "Nunca")
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <div style="display:flex; gap:var(--space-2); justify-content:flex-end; align-items:center; flex-wrap:wrap;">
                                    @* Editar papel *@
                                    <form asp-controller="Admin" asp-action="EditUserRole" asp-route-id="@u.Id"
                                          method="post" style="display:flex; gap:var(--space-1); align-items:center;">
                                        <select name="role" class="form-select" style="padding: var(--space-1) var(--space-2); font-size:0.8rem; width:auto;">
                                            <option value="Student" selected="@(u.Role == "Student")">Aluno</option>
                                            <option value="Professor" selected="@(u.Role == "Professor")">Professor</option>
                                            <option value="Admin" selected="@(u.Role == "Admin")">Admin</option>
                                        </select>
                                        <button type="submit" class="btn btn--ghost btn--sm"
                                                onclick="return confirm('Alterar o perfil de @u.Name?')">Alterar</button>
                                    </form>

                                    @* Ativar / Desativar *@
                                    <form asp-controller="Admin" asp-action="ToggleUserStatus" asp-route-id="@u.Id"
                                          method="post" style="display:inline;">
                                        @if (u.IsActive)
                                        {
                                            <button type="submit" class="btn btn--ghost btn--sm"
                                                    style="color: var(--color-danger);"
                                                    onclick="return confirm('Desativar @u.Name? A sessão ativa será terminada.')">
                                                Desativar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn--ghost btn--sm"
                                                    style="color: var(--color-success);">
                                                Ativar
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{
    ViewData["Title"] = "Utilizadores";
    ViewData["PageTitle"] = "Gerir utilizadores";
    ViewData["Role"] = "Admin";
    ViewData["ActiveMenu"] = "users";
    ViewData["UserName"] = "Administrador";
    ViewData["UserRoleLabel"] = "Admin · ISTEC";
    Layout = "_DashboardLayout";

    var users = new[]
    {
        new { Name = "Maria Costa",     Email = "maria.costa@escola.pt",   Role = "Aluno",      Active = true,  Joined = "12 abril 2026" },
        new { Name = "Prof. Santos",    Email = "santos@escola.pt",        Role = "Professor",  Active = true,  Joined = "05 set 2025" },
        new { Name = "João Pereira",    Email = "joao.p@escola.pt",        Role = "Aluno",      Active = true,  Joined = "20 abril 2026" },
        new { Name = "Ana Lopes",       Email = "ana.lopes@escola.pt",     Role = "Aluno",      Active = false, Joined = "15 mar 2026" },
        new { Name = "Prof. Marques",   Email = "marques@escola.pt",       Role = "Professor",  Active = true,  Joined = "10 out 2025" },
        new { Name = "Bruno Almeida",   Email = "bruno.a@escola.pt",       Role = "Aluno",      Active = true,  Joined = "02 maio 2026" }
    };
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Gerir utilizadores</h1>
        <p class="page-header__subtitle">@users.Length utilizadores no total.</p>
    </div>
    <div class="page-header__actions">
        <button class="btn btn--outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Exportar
        </button>
        <button class="btn btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Novo utilizador
        </button>
    </div>
</div>

<div class="filters-bar">
    <span class="filters-bar__label">Pesquisar:</span>
    <input type="search"
           class="form-control"
           placeholder="Nome ou email…"
           style="max-width: 280px; padding: var(--space-2) var(--space-3);" />
    <select class="filters-bar__select">
        <option>Todos os roles</option>
        <option>Aluno</option>
        <option>Professor</option>
        <option>Admin</option>
    </select>
    <select class="filters-bar__select">
        <option>Todos os estados</option>
        <option>Ativos</option>
        <option>Inativos</option>
    </select>
</div>

<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Utilizador</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Estado</th>
                    <th>Data de registo</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: var(--space-3);">
                                <div class="sidebar__avatar" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    @u.Name[0]
                                </div>
                                <strong>@u.Name</strong>
                            </div>
                        </td>
                        <td><span class="text-muted">@u.Email</span></td>
                        <td>
                            @if (u.Role == "Professor")
                            {
                                <span class="badge badge--info">@u.Role</span>
                            }
                            else if (u.Role == "Admin")
                            {
                                <span class="badge badge--danger">@u.Role</span>
                            }
                            else
                            {
                                <span class="badge badge--neutral">@u.Role</span>
                            }
                        </td>
                        <td>
                            @if (u.Active)
                            {
                                <span class="badge badge--success badge--dot">Ativo</span>
                            }
                            else
                            {
                                <span class="badge badge--danger badge--dot">Inativo</span>
                            }
                        </td>
                        <td><span class="text-muted">@u.Joined</span></td>
                        <td style="text-align: right;">
                            <button class="btn btn--ghost btn--sm">Editar role</button>
                            @if (u.Active)
                            {
                                <button class="btn btn--ghost btn--sm text-danger"
                                        data-confirm="Desativar @u.Name?">
                                    Desativar
                                </button>
                            }
                            else
                            {
                                <button class="btn btn--ghost btn--sm text-success">Ativar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

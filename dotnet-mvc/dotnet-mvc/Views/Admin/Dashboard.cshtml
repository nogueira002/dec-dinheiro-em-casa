@model dotnet_mvc.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Admin";
    Layout = "_DashboardLayout";
    var inactiveCount = Model.TotalUsers - Model.ActiveCount;
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Painel de administração</h1>
        <p class="page-header__subtitle">Vista geral da plataforma DEC – Dinheiro em Casa.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--outline" asp-controller="Admin" asp-action="Monitoring">Monitorização</a>
        <a class="btn btn--primary" asp-controller="Admin" asp-action="Users">Gerir utilizadores</a>
    </div>
</div>

@* ===== KPIs ===== *@
<div class="grid grid--4 mb-8">
    <div class="stat-card">
        <div class="stat-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-card__content">
            <div class="stat-card__label">Total de utilizadores</div>
            <div class="stat-card__value">@Model.TotalUsers</div>
            <div class="stat-card__hint">@Model.ActiveCount ativos · @inactiveCount inativos</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--info">🎓</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Alunos</div>
            <div class="stat-card__value">@Model.StudentCount</div>
            <div class="stat-card__hint">
                @if (Model.TotalUsers > 0)
                {
                    @($"{Math.Round((decimal)Model.StudentCount * 100 / Model.TotalUsers, 0)}% do total")
                }
            </div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--success">👨‍🏫</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Professores</div>
            <div class="stat-card__value">@Model.ProfessorCount</div>
            <div class="stat-card__hint">+ @Model.AdminCount administrador@(Model.AdminCount == 1 ? "" : "es")</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--warning">📚</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Turmas</div>
            <div class="stat-card__value">@Model.TotalClassrooms</div>
            <div class="stat-card__hint">@Model.TotalChallenges desafio@(Model.TotalChallenges == 1 ? "" : "s") publicado@(Model.TotalChallenges == 1 ? "" : "s")</div>
        </div>
    </div>
</div>

@* ===== Resumo académico + Submissões ===== *@
<div class="grid" style="grid-template-columns: 1fr 1fr; gap: var(--space-6);">

    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Utilizadores por perfil</h2>
                <p class="card__subtitle">Distribuição atual</p>
            </div>
            <a class="btn btn--ghost btn--sm" asp-controller="Admin" asp-action="Users">Ver todos →</a>
        </div>

        <div style="display:flex; flex-direction:column; gap: var(--space-4); padding: var(--space-2) 0;">
            @{
                var roles = new[]
                {
                    new { Label = "Alunos", Count = Model.StudentCount, Color = "var(--color-primary)" },
                    new { Label = "Professores", Count = Model.ProfessorCount, Color = "var(--color-success)" },
                    new { Label = "Administradores", Count = Model.AdminCount, Color = "var(--color-danger)" }
                };
            }
            @foreach (var r in roles)
            {
                var pct = Model.TotalUsers > 0
                    ? (int)Math.Round((decimal)r.Count * 100 / Model.TotalUsers)
                    : 0;
                <div>
                    <div class="progress-label">
                        <span>@r.Label</span>
                        <strong>@r.Count (@pct%)</strong>
                    </div>
                    <div class="progress progress--lg mt-1">
                        <div class="progress__bar" style="width:@pct%; background:@r.Color;"></div>
                    </div>
                </div>
            }
        </div>

        <div style="border-top: 1px solid var(--color-border); margin-top: var(--space-4); padding-top: var(--space-4);">
            <div class="progress-label">
                <span>Utilizadores ativos</span>
                <strong>@Model.ActiveCount / @Model.TotalUsers</strong>
            </div>
            @{
                var activePct = Model.TotalUsers > 0
                    ? (int)Math.Round((decimal)Model.ActiveCount * 100 / Model.TotalUsers)
                    : 0;
            }
            <div class="progress progress--lg mt-1">
                <div class="progress__bar progress__bar--success" style="width:@activePct%;"></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Submissões</h2>
                <p class="card__subtitle">Estado geral das entregas</p>
            </div>
        </div>

        <div class="grid grid--2 mb-4">
            <div class="stat-card" style="margin:0;">
                <div class="stat-card__icon stat-card__icon--info">📝</div>
                <div class="stat-card__content">
                    <div class="stat-card__label">Total</div>
                    <div class="stat-card__value">@Model.TotalSubmissions</div>
                </div>
            </div>
            <div class="stat-card" style="margin:0;">
                <div class="stat-card__icon stat-card__icon--warning">⏱</div>
                <div class="stat-card__content">
                    <div class="stat-card__label">Por avaliar</div>
                    <div class="stat-card__value">@Model.PendingSubmissions</div>
                </div>
            </div>
        </div>

        @if (Model.TotalSubmissions > 0)
        {
            var gradedCount = Model.TotalSubmissions - Model.PendingSubmissions;
            var gradedPct = (int)Math.Round((decimal)gradedCount * 100 / Model.TotalSubmissions);
            <div>
                <div class="progress-label">
                    <span>Avaliadas</span>
                    <strong>@gradedCount / @Model.TotalSubmissions (@gradedPct%)</strong>
                </div>
                <div class="progress progress--lg mt-1">
                    <div class="progress__bar progress__bar--success" style="width:@gradedPct%;"></div>
                </div>
            </div>
        }

        <div style="border-top: 1px solid var(--color-border); margin-top: var(--space-4); padding-top: var(--space-4);">
            <div class="grid grid--2" style="gap: var(--space-3);">
                <a asp-controller="Admin" asp-action="Users" class="btn btn--outline btn--sm">
                    Gerir utilizadores
                </a>
                <a asp-controller="Admin" asp-action="Monitoring" class="btn btn--outline btn--sm">
                    Ver monitorização
                </a>
            </div>
        </div>
    </div>

</div>

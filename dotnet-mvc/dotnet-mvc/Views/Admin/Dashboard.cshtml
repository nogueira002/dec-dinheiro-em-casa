@{
    ViewData["Title"] = "Dashboard Admin";
    ViewData["PageTitle"] = "Dashboard de administração";
    ViewData["Role"] = "Admin";
    ViewData["ActiveMenu"] = "dashboard";
    ViewData["UserName"] = "Administrador";
    ViewData["UserRoleLabel"] = "Admin · ISTEC";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Painel de administração de @(User.Identity?.Name ?? "Administrador")</h1>
        <p class="page-header__subtitle">Vista geral da plataforma DEC – Dinheiro em Casa.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--outline" asp-controller="Admin" asp-action="Monitoring">Ver monitorização</a>
        <a class="btn btn--primary" asp-controller="Admin" asp-action="Users">Gerir utilizadores</a>
    </div>
</div>

@* ===== KPIs ===== *@
<div class="grid grid--4 mb-8">
    <div class="stat-card">
        <div class="stat-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div class="stat-card__content">
            <div class="stat-card__label">Total de utilizadores</div>
            <div class="stat-card__value">1.482</div>
            <div class="stat-card__hint text-success">+8% este mês</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--info">🎓</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Alunos</div>
            <div class="stat-card__value">1.350</div>
            <div class="stat-card__hint">91% do total</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--success">👨‍🏫</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Professores</div>
            <div class="stat-card__value">128</div>
            <div class="stat-card__hint">Em 230 escolas</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--warning">📚</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Turmas</div>
            <div class="stat-card__value">312</div>
            <div class="stat-card__hint">42 criadas este mês</div>
        </div>
    </div>
</div>

@* ===== Gráfico + Alertas ===== *@
<div class="grid" style="grid-template-columns: 2fr 1fr; gap: var(--space-6);">

    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Utilizadores registados</h2>
                <p class="card__subtitle">Crescimento ao longo do tempo</p>
            </div>
            <select class="filters-bar__select">
                <option>Últimos 6 meses</option>
                <option>Últimos 12 meses</option>
                <option>Tudo</option>
            </select>
        </div>

        <div class="chart-placeholder">
            <svg class="chart-placeholder__line" viewBox="0 0 600 240" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="adminGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0C73B7" stop-opacity="0.4"/>
                        <stop offset="100%" stop-color="#0C73B7" stop-opacity="0"/>
                    </linearGradient>
                </defs>
                <path d="M0,210 L100,190 L200,165 L300,140 L400,100 L500,70 L600,30 L600,240 L0,240 Z"
                      fill="url(#adminGrad)" />
                <path d="M0,210 L100,190 L200,165 L300,140 L400,100 L500,70 L600,30"
                      stroke="#0C73B7" stroke-width="3" fill="none" stroke-linecap="round" />
                <g fill="#0C73B7">
                    <circle cx="100" cy="190" r="4"/>
                    <circle cx="200" cy="165" r="4"/>
                    <circle cx="300" cy="140" r="4"/>
                    <circle cx="400" cy="100" r="4"/>
                    <circle cx="500" cy="70" r="4"/>
                    <circle cx="600" cy="30" r="4"/>
                </g>
            </svg>
            <div class="chart-placeholder__label">📈 +1.482 utilizadores ativos</div>
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <h2 class="card__title">Alertas do sistema</h2>
        </div>

        <div class="activity-list">
            <div class="alert alert--success" style="margin-bottom: 0;">
                <span>✓</span>
                <div>
                    <strong>Todos os serviços operacionais</strong>
                    <div class="text-sm" style="opacity: 0.85;">Última verificação há 1 minuto</div>
                </div>
            </div>

            <div class="alert alert--warning" style="margin-bottom: 0;">
                <span>⚠</span>
                <div>
                    <strong>Pico de uso detetado</strong>
                    <div class="text-sm" style="opacity: 0.85;">238 sessões simultâneas</div>
                </div>
            </div>

            <div class="alert alert--info" style="margin-bottom: 0;">
                <span>ℹ</span>
                <div>
                    <strong>Atualização agendada</strong>
                    <div class="text-sm" style="opacity: 0.85;">15 maio · 02:00 · 30 min</div>
                </div>
            </div>
        </div>
    </div>

</div>

@model dotnet_mvc.ViewModels.Admin.MonitoringViewModel
@{
    ViewData["Title"] = "Monitorização";
    Layout = "_DashboardLayout";

    string StatusClass(bool isOnline) => isOnline ? "service-status--online" : "service-status--offline";
    string StatusLabel(bool isOnline) => isOnline ? "Online" : "Offline";

    var services = new[]
    {
        Model.Portal,
        Model.DjangoApi,
        Model.Database
    };

    var allOnline = services.All(s => s.IsOnline);
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Monitorização</h1>
        <p class="page-header__subtitle">
            Estado verificado às @Model.CheckedAtUtc.ToLocalTime().ToString("HH:mm:ss")
            de @Model.CheckedAtUtc.ToLocalTime().ToString("dd/MM/yyyy").
        </p>
    </div>
    <div class="page-header__actions">
        <a href="@Url.Action("Monitoring", "Admin")" class="btn btn--outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            Atualizar
        </a>
    </div>
</div>

@if (allOnline)
{
    <div class="alert alert--success mb-6">Todos os serviços estão operacionais.</div>
}
else
{
    <div class="alert alert--danger mb-6">Um ou mais serviços estão com problemas. Verifica os detalhes abaixo.</div>
}

<div class="grid grid--3 mb-8">
    @foreach (var svc in services)
    {
        <article class="service-card">
            <div class="service-card__header">
                <div class="service-card__name">@svc.Name</div>
                <span class="service-status @StatusClass(svc.IsOnline)">
                    <span class="service-status__dot"></span>
                    @StatusLabel(svc.IsOnline)
                </span>
            </div>
            <p class="text-sm text-muted">@svc.Description</p>
            @if (svc.ResponseTimeMs.HasValue)
            {
                <div class="service-card__metrics">
                    <div>
                        <div class="service-card__metric-label">Latência</div>
                        <div class="service-card__metric-value">@svc.ResponseTimeMs ms</div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(svc.ErrorMessage))
            {
                <p class="text-sm mt-2" style="color: var(--color-danger);">@svc.ErrorMessage</p>
            }
        </article>
    }
</div>

@model dotnet_mvc.ViewModels.Professor.CreateChallengeViewModel

@{
    var pageTitle = Model.IsEditMode ? "Editar desafio" : "Criar desafio";
    var headerTitle = Model.IsEditMode ? "Editar desafio pedagógico" : "Criar novo desafio pedagógico";
    var headerSubtitle = Model.IsEditMode
        ? "Atualiza o enunciado do desafio antes ou depois da atribuição."
        : "Define o enunciado e deixa o desafio pronto para ser atribuído a uma turma.";
    var submitLabel = Model.IsEditMode ? "Guardar alterações" : "Guardar desafio";
    var cancelAction = Model.IsEditMode ? "Challenges" : "Challenges";
    ViewData["Title"] = pageTitle;
    ViewData["PageTitle"] = pageTitle;
    ViewData["ActiveMenu"] = Model.IsEditMode ? "challenges" : "create-challenge";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">@headerTitle</h1>
        <p class="page-header__subtitle">@headerSubtitle</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--ghost" asp-controller="Professor" asp-action="@cancelAction">← Voltar</a>
    </div>
</div>

<div style="max-width: 720px;">
    <form asp-controller="Professor" asp-action="@(Model.IsEditMode ? "EditChallenge" : "CreateChallenge")" asp-route-id="@Model.Id" method="post" novalidate>
        <input asp-for="GeneratedCodePreview" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <div class="card mb-6">
            <div class="card__header">
                <div>
                    <h2 class="card__title">Conteúdo do desafio</h2>
                    <p class="card__subtitle">Define o contexto, a tarefa e o que será esperado na resposta.</p>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="form-label form-label--required"></label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Ex.: Aplicar a regra 50/30/20"
                       required />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label form-label--required"></label>
                <textarea asp-for="Description"
                          class="form-textarea"
                          rows="6"
                          placeholder="Descreve o objetivo, contexto, dados a utilizar e formato de entrega esperado."
                          required></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
                <span class="form-hint">Sê claro e específico para evitar dúvidas.</span>
            </div>
        </div>

        <div class="card mb-6">
            <div class="card__header">
                <div>
                    <h2 class="card__title">Código pedagógico</h2>
                    <p class="card__subtitle">Este código fica reservado ao desafio e será usado quando o atribuíres.</p>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); background-color: var(--color-primary-light); border-radius: var(--radius-md);">
                <span class="join-code" style="font-size: 1.2rem;">@Model.GeneratedCodePreview</span>
                <span class="text-sm text-muted">@(Model.IsEditMode ? "(código atual)" : "(pré-visualização)")</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary btn--lg">@submitLabel</button>
            @if (!Model.IsEditMode)
            {
                <a class="btn btn--outline" asp-controller="Professor" asp-action="AssignChallenge">Atribuir desafio existente</a>
            }
            <a class="btn btn--ghost" asp-controller="Professor" asp-action="@cancelAction">Cancelar</a>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css" />
    <style>
        .EasyMDEContainer .CodeMirror { min-height: 220px; font-size: 0.95rem; font-family: inherit; }
        .editor-toolbar { border-top-left-radius: var(--radius-md); border-top-right-radius: var(--radius-md); }
        .EasyMDEContainer .CodeMirror { border-bottom-left-radius: var(--radius-md); border-bottom-right-radius: var(--radius-md); }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script>
        var easyMDE = new EasyMDE({
            element: document.getElementById('Description'),
            spellChecker: false,
            autosave: { enabled: false },
            placeholder: 'Descreve o objetivo, contexto, dados a utilizar e formato de entrega esperado.\n\nPodes usar **negrito**, *itálico*, listas e títulos.',
            toolbar: [
                'bold', 'italic', 'heading-2', '|',
                'unordered-list', 'ordered-list', '|',
                'link', 'horizontal-rule', '|',
                'preview', 'guide'
            ],
            minHeight: '220px',
            status: ['lines', 'words'],
            renderingConfig: { singleLineBreaks: false }
        });

        // Garante que o valor do editor é submetido no form
        document.querySelector('form').addEventListener('submit', function () {
            document.getElementById('Description').value = easyMDE.value();
        });
    </script>
}

@model dotnet_mvc.ViewModels.Professor.CreateChallengeViewModel

@{
    ViewData["Title"] = "Criar desafio";
    ViewData["PageTitle"] = "Criar desafio";
    ViewData["Role"] = "Professor";
    ViewData["ActiveMenu"] = "create-challenge";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Criar novo desafio</h1>
        <p class="page-header__subtitle">Define o desafio que vais atribuir aos teus alunos.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--ghost" asp-controller="Professor" asp-action="Classes">← Voltar</a>
    </div>
</div>

<div style="max-width: 720px;">
    <form asp-controller="Professor" asp-action="CreateChallenge" method="post" novalidate>
        <input asp-for="GeneratedCodePreview" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <div class="card mb-6">
            <div class="card__header">
                <div>
                    <h2 class="card__title">Conteúdo do desafio</h2>
                    <p class="card__subtitle">O que queres que os alunos façam?</p>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Title" class="form-label form-label--required"></label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Ex.: Aplicar a regra 50/30/20"
                       required />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label form-label--required"></label>
                <textarea asp-for="Description"
                          class="form-textarea"
                          rows="6"
                          placeholder="Descreve o objetivo, contexto, dados a utilizar e formato de entrega esperado."
                          required></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
                <span class="form-hint">Sê claro e específico para evitar dúvidas.</span>
            </div>
        </div>

        <div class="card mb-6">
            <div class="card__header">
                <div>
                    <h2 class="card__title">Atribuição</h2>
                    <p class="card__subtitle">A que turma vais atribuir este desafio?</p>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ClassId" class="form-label form-label--required"></label>
                    <select asp-for="ClassId" asp-items="Model.AvailableClasses" class="form-select" required>
                        <option value="">— Escolher turma —</option>
                    </select>
                    <span asp-validation-for="ClassId" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Deadline" class="form-label form-label--required"></label>
                    <input asp-for="Deadline"
                           class="form-control"
                           type="date"
                           required />
                    <span asp-validation-for="Deadline" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-check">
                <input asp-for="NotifyStudents" />
                <label asp-for="NotifyStudents"></label>
            </div>
        </div>

        <div class="card mb-6">
            <div class="card__header">
                <div>
                    <h2 class="card__title">Código de adesão</h2>
                    <p class="card__subtitle">Vai ser gerado automaticamente após criares o desafio.</p>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); background-color: var(--color-primary-light); border-radius: var(--radius-md);">
                <span class="join-code" style="font-size: 1.2rem;">@Model.GeneratedCodePreview</span>
                <span class="text-sm text-muted">(pré-visualização)</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary btn--lg">Atribuir desafio</button>
            <a class="btn btn--ghost" asp-controller="Professor" asp-action="Classes">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

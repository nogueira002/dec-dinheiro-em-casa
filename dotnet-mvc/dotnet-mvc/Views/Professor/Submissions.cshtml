@model dotnet_mvc.ViewModels.Professor.SubmissionsIndexViewModel

@{
    ViewData["Title"] = "Submissões";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Avaliar submissões</h1>
        <p class="page-header__subtitle">
            @Model.PendingCount submissão@(Model.PendingCount == 1 ? "" : "ões") pendente@(Model.PendingCount == 1 ? "" : "s") de avaliação.
        </p>
    </div>
</div>

<div class="grid grid--3 mb-8">
    <div class="stat-card">
        <div class="stat-card__icon">📋</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Total</div>
            <div class="stat-card__value">@(Model.PendingCount + Model.GradedCount)</div>
            <div class="stat-card__hint">Submissões recebidas</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--warning">⏳</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Pendentes</div>
            <div class="stat-card__value">@Model.PendingCount</div>
            <div class="stat-card__hint">Por avaliar</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--success">✓</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Avaliadas</div>
            <div class="stat-card__value">@Model.GradedCount</div>
            <div class="stat-card__hint">Com nota atribuída</div>
        </div>
    </div>
</div>

@* ===== Filtros ===== *@
<form method="get" asp-controller="Professor" asp-action="Submissions" class="filters-bar">
    <span class="filters-bar__label">Estado:</span>
    <select class="filters-bar__select" name="status" onchange="this.form.submit()">
        <option value="" selected="@(Model.StatusFilter == null)">Todas</option>
        <option value="pending" selected="@(Model.StatusFilter == "pending")">Pendentes</option>
        <option value="graded" selected="@(Model.StatusFilter == "graded")">Avaliadas</option>
    </select>

    @if (Model.AvailableClasses.Count > 0)
    {
        <select class="filters-bar__select" name="classroomId" onchange="this.form.submit()">
            <option value="">Todas as turmas</option>
            @foreach (var c in Model.AvailableClasses)
            {
                <option value="@c.Id" selected="@(Model.SelectedClassroomId == c.Id)">@c.Name</option>
            }
        </select>
    }

    @if (Model.AvailableChallenges.Count > 0)
    {
        <select class="filters-bar__select" name="challengeId" onchange="this.form.submit()">
            <option value="">Todos os desafios</option>
            @foreach (var ch in Model.AvailableChallenges)
            {
                <option value="@ch.Id" selected="@(Model.SelectedChallengeId == ch.Id)">@ch.Title</option>
            }
        </select>
    }

    @if (Model.SelectedChallengeId.HasValue || Model.SelectedClassroomId.HasValue || Model.StatusFilter != null)
    {
        <a class="btn btn--ghost btn--sm" asp-controller="Professor" asp-action="Submissions">Limpar filtros</a>
    }
</form>

@if (Model.Submissions.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state__icon">📭</div>
        <div class="empty-state__title">Sem submissões</div>
        <p class="empty-state__text">
            @if (Model.SelectedChallengeId.HasValue || Model.SelectedClassroomId.HasValue || Model.StatusFilter != null)
            {
                <span>Nenhuma submissão encontrada para os filtros selecionados.</span>
            }
            else
            {
                <span>Os alunos ainda não submeteram respostas aos desafios.</span>
            }
        </p>
    </div>
}
else
{
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Turma</th>
                        <th>Desafio</th>
                        <th>Data</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Submissions)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: var(--space-3);">
                                    <div class="sidebar-avatar" style="width: 2rem; height: 2rem; font-size: 0.85rem; border-radius: 0.375rem;">
                                        @s.StudentName[0]
                                    </div>
                                    <strong>@s.StudentName</strong>
                                </div>
                            </td>
                            <td>@s.ClassroomName</td>
                            <td>@s.ChallengeTitle</td>
                            <td>
                                <span class="text-muted">
                                    @s.SubmittedAtUtc.ToLocalTime().ToString("dd MMM · HH:mm")
                                    @if (s.UpdatedAtUtc.HasValue)
                                    {
                                        <span title="Atualizado a @s.UpdatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")"> ✎</span>
                                    }
                                </span>
                            </td>
                            <td>
                                @if (s.IsGraded)
                                {
                                    <span class="badge badge--success">@s.GradeDisplay</span>
                                }
                                else
                                {
                                    <span class="badge badge--warning">Pendente</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <a class="btn @(s.IsGraded ? "btn--outline" : "btn--primary") btn--sm"
                                   asp-controller="Professor"
                                   asp-action="ReviewSubmission"
                                   asp-route-id="@s.Id">
                                    @(s.IsGraded ? "Ver / Corrigir" : "Avaliar")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

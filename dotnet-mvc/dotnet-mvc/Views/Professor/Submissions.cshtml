@{
    ViewData["Title"] = "Submissões";
    ViewData["PageTitle"] = "Avaliar submissões";
    ViewData["Role"] = "Professor";
    ViewData["ActiveMenu"] = "submissions";
    ViewData["UserName"] = "Prof. Santos";
    ViewData["UserRoleLabel"] = "Professor";
    Layout = "_DashboardLayout";

    var submissions = new[]
    {
        new { Student = "Maria Costa",   Class = "11.º A", Challenge = "Crédito habitação",       Date = "08 maio · 14:32", Status = "pending" },
        new { Student = "João Pereira",  Class = "11.º B", Challenge = "Poupança 50/30/20",       Date = "08 maio · 11:05", Status = "pending" },
        new { Student = "Ana Lopes",     Class = "11.º A", Challenge = "Orçamento mensal",        Date = "07 maio · 18:21", Status = "graded" },
        new { Student = "Tiago Marques", Class = "12.º A", Challenge = "Análise de investimento", Date = "07 maio · 09:48", Status = "pending" },
        new { Student = "Sofia Ribeiro", Class = "11.º A", Challenge = "Orçamento mensal",        Date = "06 maio · 22:10", Status = "graded" }
    };
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Avaliar submissões</h1>
        <p class="page-header__subtitle">14 submissões pendentes de avaliação.</p>
    </div>
</div>

@* ===== Filtros ===== *@
<div class="filters-bar">
    <span class="filters-bar__label">Estado:</span>
    <select class="filters-bar__select">
        <option>Todas</option>
        <option>Pendentes</option>
        <option>Avaliadas</option>
    </select>
    <select class="filters-bar__select">
        <option>Todas as turmas</option>
        <option>11.º A</option>
        <option>11.º B</option>
        <option>12.º A</option>
    </select>
</div>

<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Aluno</th>
                    <th>Turma</th>
                    <th>Desafio</th>
                    <th>Data</th>
                    <th>Estado</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in submissions)
                {
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: var(--space-3);">
                                <div class="sidebar__avatar" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    @s.Student[0]
                                </div>
                                <strong>@s.Student</strong>
                            </div>
                        </td>
                        <td>@s.Class</td>
                        <td>@s.Challenge</td>
                        <td><span class="text-muted">@s.Date</span></td>
                        <td>
                            @if (s.Status == "pending")
                            {
                                <span class="badge badge--warning">Pendente</span>
                            }
                            else
                            {
                                <span class="badge badge--success">Avaliada</span>
                            }
                        </td>
                        <td style="text-align: right;">
                            @if (s.Status == "pending")
                            {
                                <button class="btn btn--primary btn--sm" data-toggle-modal="#evalModal">Avaliar</button>
                            }
                            else
                            {
                                <button class="btn btn--outline btn--sm">Ver</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ===== Painel de avaliação (inline) ===== *@
<div class="card mt-8" id="evalModal">
    <div class="card__header">
        <div>
            <h2 class="card__title">Avaliar: "Crédito habitação"</h2>
            <p class="card__subtitle">Maria Costa · 11.º A · submetido a 08 maio 14:32</p>
        </div>
        <span class="badge badge--warning">Pendente</span>
    </div>

    <div class="alert alert--info mb-4">
        <span>📝</span>
        <div>
            <strong>Resposta do aluno:</strong>
            <p style="margin-top: var(--space-2); margin-bottom: 0;">
                Comparei três cenários de crédito habitação a 30 anos com TAEG
                de 3,5%, 4,2% e 5,1%. O cenário mais vantajoso é o primeiro,
                com uma poupança total de 28.450 € em juros face ao mais caro…
            </p>
        </div>
    </div>

    <form>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label form-label--required" for="Grade">Nota (0-20)</label>
                <input class="form-control"
                       type="number"
                       id="Grade"
                       name="Grade"
                       min="0"
                       max="20"
                       step="0.5"
                       placeholder="Ex.: 17.5"
                       required />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label form-label--required" for="Feedback">Feedback</label>
            <textarea class="form-textarea"
                      id="Feedback"
                      name="Feedback"
                      rows="5"
                      placeholder="Comentários, sugestões de melhoria, pontos fortes..."
                      required></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Submeter avaliação</button>
            <button type="button" class="btn btn--ghost">Guardar rascunho</button>
        </div>
    </form>
</div>

@using System.Globalization
@model dotnet_mvc.ViewModels.Professor.ProfessorStudentsIndexViewModel

@{
    ViewData["Title"] = "Alunos";
    Layout = "_DashboardLayout";

    string WidthValue(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Progresso por aluno</h1>
        <p class="page-header__subtitle">Acompanha entregas, avaliações e taxa de conclusão nas tuas turmas e desafios.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--outline" asp-controller="Professor" asp-action="Classes">Ver turmas</a>
    </div>
</div>

<form method="get" asp-controller="Professor" asp-action="Progress" class="filters-bar">
    <span class="filters-bar__label">Turma:</span>
    <select name="classId" class="filters-bar__select">
        <option value="">Todas</option>
        @foreach (var classroom in Model.AvailableClasses)
        {
            if (Model.SelectedClassId == classroom.Id)
            {
                <option value="@classroom.Id" selected>@classroom.Name</option>
            }
            else
            {
                <option value="@classroom.Id">@classroom.Name</option>
            }
        }
    </select>
    <button type="submit" class="btn btn--outline btn--sm">Filtrar</button>
    @if (Model.SelectedClassId.HasValue)
    {
        <a class="btn btn--ghost btn--sm" asp-controller="Professor" asp-action="Progress">Limpar filtro</a>
    }
</form>

<div class="grid grid--4 mb-8">
    <div class="stat-card">
        <div class="stat-card__icon">👥</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Alunos</div>
            <div class="stat-card__value">@Model.TotalStudents</div>
            <div class="stat-card__hint">No contexto selecionado</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--info">✎</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Submissões</div>
            <div class="stat-card__value">@Model.TotalSubmittedChallenges</div>
            <div class="stat-card__hint">De @Model.TotalAvailableChallenges desafios disponíveis</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--success">✓</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Avaliadas</div>
            <div class="stat-card__value">@Model.TotalReviewedChallenges</div>
            <div class="stat-card__hint">Já com feedback/nota</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--warning">%</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Conclusão</div>
            <div class="stat-card__value">@Model.OverallCompletionRateLabel</div>
            <div class="stat-card__hint">Taxa global de entrega</div>
        </div>
    </div>
</div>

@if (Model.Students.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state__icon">👤</div>
        <div class="empty-state__title">Ainda não há alunos associados</div>
        <p class="empty-state__text">
            Quando os alunos entrarem numa turma ou num desafio através do código de adesão, eles passam a aparecer aqui.
        </p>
        <a class="btn btn--primary" asp-controller="Professor" asp-action="Classes">Voltar às turmas</a>
    </div>
}
else
{
    <div class="table-wrapper">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Turma</th>
                        <th>Associação</th>
                        <th>Progresso</th>
                        <th>Avaliação</th>
                        <th>Associado desde</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        var progressBarClass = student.CompletionRatePercent >= 75
                            ? "progress__bar--success"
                            : student.CompletionRatePercent > 0
                                ? "progress__bar--warning"
                                : "progress__bar--danger";

                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: var(--space-3);">
                                    <div class="sidebar__avatar" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        @student.Name[0]
                                    </div>
                                    <div>
                                        <strong>@student.Name</strong>
                                        <div class="text-sm text-muted">@student.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@student.ClassroomName</td>
                            <td>
                                <span class="badge @(student.AssociationLabel == "Turma" ? "badge--success" : "badge--info")">
                                    @student.AssociationLabel
                                </span>
                            </td>
                            <td>
                                <div class="progress-label">
                                    <span>@student.SubmittedChallengesCount / @student.AvailableChallengesCount entregues</span>
                                    <strong>@student.CompletionRateLabel</strong>
                                </div>
                                <div class="progress progress--sm mt-2">
                                    <div class="progress__bar @progressBarClass" style="width: @(WidthValue(student.CompletionRatePercent))%;"></div>
                                </div>
                                <div class="text-sm text-muted mt-2">
                                    @student.MissingChallengesCount por entregar · @student.ActiveChallengesCount desafios ainda ativos
                                </div>
                                <div class="text-sm text-muted mt-1">@student.ChallengeSummary</div>
                            </td>
                            <td>
                                <div class="text-sm fw-medium">@student.ReviewedChallengesCount avaliados</div>
                                <div class="text-sm text-muted mt-1">
                                    @(student.SubmittedChallengesCount - student.ReviewedChallengesCount) pendentes de revisão
                                </div>
                                <div class="text-sm text-muted mt-1">
                                    Média: <strong>@(student.AverageGrade ?? "Sem nota")</strong>
                                </div>
                            </td>
                            <td>@student.JoinedAtUtc.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

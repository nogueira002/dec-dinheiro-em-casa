@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar password";
    Layout = "_AuthLayout";
}

@if (!Model.IsConfirmationDisplayed)
{
    <h1 class="auth__title">Recuperar a tua password</h1>
    <p class="auth__subtitle">
        Indica o email da tua conta. Vamos enviar-te um link para definires
        uma nova password.
    </p>

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label form-label--required"></label>
            <input asp-for="Email"
                   class="form-control"
                   placeholder="exemplo@escola.pt"
                   autocomplete="email"
                   required />
            <span asp-validation-for="Email" class="field-validation-error"></span>
            <span class="form-hint">Vamos enviar instruções para este email.</span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary btn--block btn--lg">
                Enviar instruções
            </button>
        </div>
    </form>

    <p class="auth__footer-text">
        Lembraste-te?
        <a asp-controller="Auth" asp-action="Login">Voltar a entrar</a>
    </p>
}
else
{
    <div class="text-center">
        <div class="empty-state__icon" style="margin-bottom: 1.5rem;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
            </svg>
        </div>
        <h1 class="auth__title">Verifica o teu email</h1>
        <p class="auth__subtitle">
            Se o email que indicaste estiver associado a uma conta, vais
            receber as instruções de recuperação dentro de minutos.
        </p>

        <a class="btn btn--primary btn--block btn--lg mt-4" asp-controller="Auth" asp-action="Login">
            Voltar a entrar
        </a>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

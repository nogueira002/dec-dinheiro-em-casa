@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar password";
    Layout = "_AuthLayout";
}

@if (!Model.IsConfirmationDisplayed)
{
    <div class="ac-head">
        <h1>Recuperar password</h1>
        <div class="ac-sub">Indica o email da tua conta e enviamos-te um link para definires uma nova password.</div>
    </div>

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate class="stack-2">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <div class="field">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email"
                   class="input"
                   placeholder="exemplo@escola.pt"
                   autocomplete="email"
                   required />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">
            Enviar instruções
        </button>
    </form>

    <p class="auth-footer-text">
        Lembraste-te?
        <a asp-controller="Auth" asp-action="Login">Voltar a entrar</a>
    </p>
}
else
{
    <div style="text-align:center;">
        <div style="width:56px;height:56px;border-radius:var(--r-lg);background:var(--blue-50);color:var(--blue-500);display:grid;place-items:center;margin:0 auto 20px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
            </svg>
        </div>
        <h1 style="font-size:22px;margin-bottom:10px;">Verifica o teu email</h1>
        <p style="color:var(--muted-foreground);font-size:14px;line-height:1.6;margin-bottom:24px;">
            Se o email que indicaste estiver associado a uma conta, vais receber as instruções de recuperação dentro de minutos.
        </p>
        <a class="btn btn-primary btn-lg btn-block" asp-controller="Auth" asp-action="Login">
            Voltar a entrar
        </a>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

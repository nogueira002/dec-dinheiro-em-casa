@model RegisterViewModel

@{
    ViewData["Title"] = "Criar conta";
    Layout = "_AuthLayout";
}

<h1 class="auth__title">Cria a tua conta</h1>
<p class="auth__subtitle">É gratuito e leva menos de um minuto.</p>

<form asp-controller="Auth" asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

    <div class="form-group">
        <label asp-for="Name" class="form-label form-label--required"></label>
        <input asp-for="Name"
               class="form-control"
               placeholder="Ex.: Maria Costa"
               autocomplete="name"
               required />
        <span asp-validation-for="Name" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email" class="form-label form-label--required"></label>
        <input asp-for="Email"
               class="form-control"
               placeholder="exemplo@escola.pt"
               autocomplete="email"
               required />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label asp-for="Password" class="form-label form-label--required"></label>
            <input asp-for="Password"
                   class="form-control"
                   placeholder="Mínimo 8 caracteres"
                   autocomplete="new-password"
                   required />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label form-label--required"></label>
            <input asp-for="ConfirmPassword"
                   class="form-control"
                   placeholder="Repete a password"
                   autocomplete="new-password"
                   required />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Role" class="form-label form-label--required">Sou…</label>
        <div class="option-cards">
            <label class="option-card">
                <input asp-for="Role" type="radio" value="Student" />
                <div class="option-card__title">Aluno</div>
                <div class="option-card__desc">Quero aprender e fazer cenários</div>
            </label>
            <label class="option-card">
                <input asp-for="Role" type="radio" value="Professor" />
                <div class="option-card__title">Professor</div>
                <div class="option-card__desc">Quero gerir turmas e desafios</div>
            </label>
        </div>
        <span asp-validation-for="Role" class="field-validation-error"></span>
    </div>

    <div class="form-check">
        <input asp-for="Terms" />
        <label asp-for="Terms">
            Aceito os <a href="#">termos de utilização</a> e a
            <a asp-controller="Home" asp-action="Privacy">política de privacidade</a>.
        </label>
        <span asp-validation-for="Terms" class="field-validation-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn--primary btn--block btn--lg">
            Criar conta
        </button>
    </div>
</form>

<p class="auth__footer-text">
    Já tens conta?
    <a asp-controller="Auth" asp-action="Login">Entrar</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

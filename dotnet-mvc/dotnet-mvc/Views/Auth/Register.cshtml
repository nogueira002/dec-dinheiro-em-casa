@model RegisterViewModel

@{
    ViewData["Title"] = "Criar conta";
    Layout = "_AuthLayout";
}

<div class="ac-head">
    <h1>Criar conta</h1>
    <div class="ac-sub">Junta-te à DEC e começa a tua jornada financeira.</div>
</div>

<form asp-controller="Auth" asp-action="Register" method="post" novalidate class="stack-2">

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

    <div class="field">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name"
               class="input"
               placeholder="Ex.: Maria Costa"
               autocomplete="name"
               required />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email"
               class="input"
               placeholder="exemplo@escola.pt"
               autocomplete="email"
               required />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="form-row">
        <div class="field">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password"
                   class="input"
                   placeholder="Mínimo 8 caracteres"
                   autocomplete="new-password"
                   required />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword"
                   class="input"
                   placeholder="Repete a password"
                   autocomplete="new-password"
                   required />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
    </div>

    <div class="field">
        <label class="form-label">Sou…</label>
        <div class="role-pick">
            <label class="role-opt">
                <input asp-for="Role" type="radio" value="Student" />
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/></svg>
                <div class="ro-name">Aluno</div>
            </label>
            <label class="role-opt">
                <input asp-for="Role" type="radio" value="Professor" />
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19a4 4 0 0 0-8 0"/><circle cx="12" cy="9" r="3"/><path d="M5 19a3 3 0 0 1 3-3M19 19a3 3 0 0 0-3-3"/></svg>
                <div class="ro-name">Professor</div>
            </label>
        </div>
        <span asp-validation-for="Role" class="field-error"></span>
    </div>

    <label class="check">
        <input asp-for="Terms" />
        <span>Aceito os <a asp-controller="Home" asp-action="Privacy">termos</a> e a <a asp-controller="Home" asp-action="Privacy">política de privacidade</a></span>
    </label>
    <span asp-validation-for="Terms" class="field-error" style="margin-top:-12px;display:block;"></span>

    <button type="submit" class="btn btn-primary btn-lg btn-block">
        Criar a minha conta
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </button>
</form>

<p class="auth-footer-text">
    Já tens conta?
    <a asp-controller="Auth" asp-action="Login">Entrar</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model LoginViewModel

@{
    ViewData["Title"] = "Entrar";
    Layout = "_AuthLayout";
}

<h1 class="auth__title">Bem-vindo de volta!</h1>
<p class="auth__subtitle">Entra na tua conta para continuares a aprender.</p>

<form asp-controller="Auth" asp-action="Login" method="post" novalidate>
    <input asp-for="ReturnUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

    <div class="form-group">
        <label asp-for="Email" class="form-label form-label--required"></label>
        <input asp-for="Email"
               class="form-control"
               placeholder="exemplo@escola.pt"
               autocomplete="email"
               required />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="form-label form-label--required"></label>
        <input asp-for="Password"
               class="form-control"
               placeholder="A tua password"
               autocomplete="current-password"
               required />
        <span asp-validation-for="Password" class="field-validation-error"></span>
        <div class="auth__forgot">
            <a asp-controller="Auth" asp-action="ForgotPassword">Esqueci-me da password</a>
        </div>
    </div>

    <div class="form-check">
        <input asp-for="RememberMe" />
        <label asp-for="RememberMe"></label>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn--primary btn--block btn--lg">
            Entrar
        </button>
    </div>
</form>

<div class="auth__divider">ou</div>

<p class="auth__footer-text">
    Ainda não tens conta?
    <a asp-controller="Auth" asp-action="Register">Cria a tua conta gratuita</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

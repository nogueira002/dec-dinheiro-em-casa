@{
    ViewData["Title"] = "Início";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DEC – Dinheiro em Casa · Literacia financeira para o secundário</title>
  <meta name="description" content="A DEC é a plataforma educativa que ensina os alunos do ensino secundário a gerir orçamentos familiares reais, simular decisões financeiras e responder a desafios propostos pelo professor." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body class="lp">

  <!-- ============ NAV ============ -->
  <nav class="lp-nav" id="nav">
    <a class="lp-brand" asp-controller="Home" asp-action="Index">
      <span class="sb-logo"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 11a7 4 0 0 0-7-3.8C8 7.2 5 9 5 11.5c0 1.3.8 2.4 2 3.2V18h2.5l.5-1.4a10 10 0 0 0 4 0L14.5 18H17v-3.3c1.2-.8 2-2 2-3.2Z"/><path d="M5.5 10.5C4 10.2 3 9.4 3 8.5M9 7.2 8 5.5"/></svg></span>
      <span><span class="lp-name">DEC</span> <span class="lp-tag">· Dinheiro em Casa</span></span>
    </a>
    <div class="lp-links">
      <a href="#sobre">Sobre</a>
      <a href="#perfis">Para quem</a>
      <a href="#como">Como funciona</a>
      <a href="#funcionalidades">Funcionalidades</a>
    </div>
    <span class="grow"></span>
    <div class="lp-nav-cta">
      @if (User.Identity?.IsAuthenticated == true)
      {
        if (User.IsInRole("Admin"))
        {
          <a class="btn btn-ghost btn-sm" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
        }
        else if (User.IsInRole("Professor"))
        {
          <a class="btn btn-ghost btn-sm" asp-controller="Professor" asp-action="Dashboard">Dashboard</a>
        }
        else
        {
          <a class="btn btn-ghost btn-sm" asp-controller="Student" asp-action="Dashboard">Dashboard</a>
        }
        <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline;">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn-sm">Sair</button>
        </form>
      }
      else
      {
        <a class="btn btn-ghost btn-sm" asp-controller="Auth" asp-action="Login">Entrar</a>
        <a class="btn btn-sm" asp-controller="Auth" asp-action="Register">Registar</a>
      }
    </div>
  </nav>

  <!-- ============ HERO ============ -->
  <header class="lp-hero" id="topo">
    <div class="lp-hero-inner">
      <span class="lp-eyebrow"><span class="pin">Projeto ISTEC</span> Plataforma educativa de literacia financeira <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></span>
      <h1>O dinheiro <span class="hl">começa em casa.</span></h1>
      <p class="lead">A DEC coloca os alunos do ensino secundário dentro de cenários familiares reais — onde aprendem a registar rendimentos, controlar despesas, definir objetivos de poupança e simular decisões financeiras com o apoio do professor.</p>
      <div class="lp-hero-actions">
        <a class="btn btn-primary btn-lg" asp-controller="Auth" asp-action="Register">Criar conta gratuita<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></a>
        <a class="btn btn-secondary btn-lg" href="#como">Ver como funciona</a>
      </div>
      <div class="lp-trust">
        <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Gratuito para alunos e professores</span>
        <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>4 simuladores financeiros incluídos</span>
        <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Desafios com correção do professor</span>
      </div>
    </div>

    <!-- Screenshot real da dashboard -->
    <div class="lp-mock">
      <div class="lp-mock-card">
        <div class="lp-mock-top">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="l">dec-dinheiro-em-casa.pt · Dashboard</span>
        </div>
        <div class="lp-mock-screenshot">
          <img src="~/images/dashboard-preview.png" alt="Dashboard DEC – Dinheiro em Casa" />
        </div>
      </div>
      <div class="lp-float f1">
        <span class="fi" style="background:var(--green-50);color:var(--green-600)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V3"/><path d="m6 9 6-6 6 6"/></svg></span>
        <span><span class="ft">Salário registado</span><br /><span class="fv pos">+€900,00</span></span>
      </div>
      <div class="lp-float f2">
        <span class="fi" style="background:var(--blue-50);color:var(--blue-500)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/></svg></span>
        <span><span class="ft">Objetivo: fundo de emergência</span><br /><span class="fv">Faltam €180</span></span>
      </div>
    </div>
  </header>

  <!-- ============ SOBRE ============ -->
  <section class="lp-sec alt" id="sobre">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <span class="eyebrow">O que é a DEC</span>
        <h2>Aprende finanças reais, não teoria abstrata.</h2>
        <p>A DEC coloca o aluno dentro de um cenário familiar concreto — uma família monoparental, um casal, um estudante deslocado — e ensina-o a tomar decisões financeiras reais com consequências visíveis.</p>
      </div>
      <div class="lp-feats">
        <div class="lp-feat reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M9 20v-5a3 3 0 0 1 6 0v5"/></svg></span>
          <h4>Cenários familiares reais</h4>
          <p>Cada aluno trabalha com um cenário com rendimentos, despesas fixas e número de membros do agregado — baseado em contextos do dia a dia português.</p>
        </div>
        <div class="lp-feat fc-green reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 14 3-3 3 2 4-5"/></svg></span>
          <h4>Decisões com impacto visível</h4>
          <p>O aluno vê imediatamente como cada lançamento altera o saldo do mês, o progresso de um objetivo ou a taxa de esforço da família.</p>
        </div>
        <div class="lp-feat fc-amber reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19a4 4 0 0 0-8 0"/><circle cx="12" cy="9" r="3"/><path d="M5 19a3 3 0 0 1 3-3M19 19a3 3 0 0 0-3-3"/></svg></span>
          <h4>Acompanhamento do professor</h4>
          <p>O professor cria turmas, lança desafios pedagógicos, revê as respostas e dá feedback escrito e nota — tudo numa única plataforma.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ESTATÍSTICAS ============ -->
  <section class="lp-sec dark">
    <div class="lp-wrap">
      <div class="lp-stats">
        <div class="lp-stat reveal"><div class="n">3</div><div class="d">perfis de cenário familiar: Estudante deslocado, Casal e Família monoparental</div></div>
        <div class="lp-stat reveal"><div class="n b">4</div><div class="d">simuladores financeiros integrados: juros compostos, crédito, taxa de esforço e projeção de fluxo de caixa</div></div>
        <div class="lp-stat reveal"><div class="n">3</div><div class="d">perfis de utilizador: Aluno, Professor e Administrador com painéis dedicados</div></div>
      </div>
    </div>
  </section>

  <!-- ============ PERFIS ============ -->
  <section class="lp-sec" id="perfis">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <span class="eyebrow">Para quem</span>
        <h2>Uma plataforma, três experiências distintas</h2>
        <p>Cada perfil tem as ferramentas certas para o seu papel — desde o aluno que gere o orçamento familiar ao administrador que supervisiona toda a escola.</p>
      </div>
      <div class="lp-roles">
        <div class="lp-role r-aluno reveal">
          <span class="ri"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/></svg></span>
          <div class="rsub">Aluno</div>
          <h3>Gere o orçamento familiar</h3>
          <p>Trabalha dentro de um cenário familiar com rendimentos e despesas reais, toma decisões e vê o impacto imediato.</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Criar cenários (casal, família, estudante)</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Registar receitas e despesas mensais</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Definir e acompanhar objetivos de poupança</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Correr 4 simuladores financeiros</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Responder a desafios da turma</li>
          </ul>
        </div>
        <div class="lp-role r-professor reveal">
          <span class="ri"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19a4 4 0 0 0-8 0"/><circle cx="12" cy="9" r="3"/><path d="M5 19a3 3 0 0 1 3-3M19 19a3 3 0 0 0-3-3"/></svg></span>
          <div class="rsub">Professor</div>
          <h3>Conduz as aulas com desafios</h3>
          <p>Cria turmas, lança desafios pedagógicos e acompanha as entregas — com correção escrita e nota para cada aluno.</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Criar e gerir turmas com código de acesso</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Criar e publicar desafios financeiros</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Atribuir desafios a turmas específicas</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Rever respostas e dar nota e feedback</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Acompanhar progresso por aluno</li>
          </ul>
        </div>
        <div class="lp-role r-admin reveal">
          <span class="ri"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v6c0 4 3 7 7 8 4-1 7-4 7-8V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div class="rsub">Administrador</div>
          <h3>Supervisiona toda a plataforma</h3>
          <p>Controlo total dos utilizadores, papéis e estado das contas — com visão global das métricas da escola.</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Gerir todos os utilizadores</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Ativar, desativar e alterar perfis</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Promover aluno a professor ou admin</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Ver distribuição de papéis e atividade</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Monitorizar saúde do sistema</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMO FUNCIONA ============ -->
  <section class="lp-sec alt" id="como">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <span class="eyebrow">Como funciona</span>
        <h2>Da aula ao orçamento real em 4 passos</h2>
      </div>
      <div class="lp-steps">
        <div class="lp-step reveal">
          <div class="sn">1</div>
          <h4>O professor cria a turma</h4>
          <p>Regista-se, cria uma turma e publica um desafio financeiro. Os alunos entram com o código de acesso gerado automaticamente.</p>
        </div>
        <div class="lp-step reveal">
          <div class="sn">2</div>
          <h4>O aluno cria o seu cenário</h4>
          <p>Escolhe um perfil familiar — casal, família monoparental ou estudante deslocado — e define os rendimentos e despesas do agregado.</p>
        </div>
        <div class="lp-step reveal">
          <div class="sn">3</div>
          <h4>Regista, simula e decide</h4>
          <p>Lança receitas e despesas mensais, define objetivos de poupança e experimenta os 4 simuladores: juros, crédito, taxa de esforço e projeção de caixa.</p>
        </div>
        <div class="lp-step reveal">
          <div class="sn">4</div>
          <h4>Responde e recebe feedback</h4>
          <p>Usa o espaço de trabalho do desafio para comparar estratégias, submete a resposta e recebe nota e comentário do professor.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FUNCIONALIDADES ============ -->
  <section class="lp-sec" id="funcionalidades">
    <div class="lp-wrap">
      <div class="lp-head reveal">
        <span class="eyebrow">Funcionalidades</span>
        <h2>Tudo o que um aluno precisa para aprender finanças</h2>
      </div>
      <div class="lp-feats">
        <div class="lp-feat reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M9 20v-5a3 3 0 0 1 6 0v5"/></svg></span>
          <h4>Cenários familiares</h4>
          <p>Cria múltiplos cenários com perfil (casal, monoparental, estudante), localização, número de membros e saldo inicial.</p>
        </div>
        <div class="lp-feat fc-green reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h13"/><path d="m14 4 3 3-3 3"/><path d="M20 17H7"/><path d="m10 20-3-3 3-3"/></svg></span>
          <h4>Lançamentos financeiros</h4>
          <p>Regista receitas e despesas por categoria, mês e ano. Suporta lançamentos recorrentes e filtragem por tipo.</p>
        </div>
        <div class="lp-feat fc-amber reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/></svg></span>
          <h4>Objetivos de poupança</h4>
          <p>Define metas com valor alvo e prazo em meses. Acompanha o progresso com contribuições incrementais e percentagem de conclusão.</p>
        </div>
        <div class="lp-feat fc-violet reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2"/></svg></span>
          <h4>4 simuladores financeiros</h4>
          <p>Taxa de esforço, capitalização composta, amortização de crédito e projeção de fluxo de caixa com inflação. Histórico das últimas 8 simulações.</p>
        </div>
        <div class="lp-feat reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v4a5 5 0 0 1-10 0V4Z"/><path d="M9.5 14.5 9 20h6l-.5-5.5M7 21h10"/></svg></span>
          <h4>Desafios pedagógicos</h4>
          <p>O professor publica desafios financeiros com prazo. O aluno usa o espaço de trabalho integrado para simular estratégias antes de submeter a resposta.</p>
        </div>
        <div class="lp-feat fc-green reveal">
          <span class="fi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19a4 4 0 0 0-8 0"/><circle cx="12" cy="9" r="3"/><path d="M5 19a3 3 0 0 1 3-3M19 19a3 3 0 0 0-3-3"/></svg></span>
          <h4>Turmas e correção</h4>
          <p>O professor cria turmas com código único, atribui desafios, revê cada entrega e devolve nota e feedback escrito ao aluno.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="lp-sec" style="padding-top:0;">
    <div class="lp-cta reveal">
      <h2>Pronto para trazer literacia financeira real à sala de aula?</h2>
      <p>Cria a tua conta gratuita e começa hoje — seja aluno a gerir o primeiro orçamento, seja professor a lançar o primeiro desafio.</p>
      <div class="lp-hero-actions">
        <a class="btn btn-primary btn-lg" asp-controller="Auth" asp-action="Register">Criar conta gratuita</a>
        <a class="btn btn-secondary btn-lg" asp-controller="Auth" asp-action="Login">Já tenho conta</a>
      </div>
    </div>
  </section>

  <!-- ============ RODAPÉ ============ -->
  <footer class="lp-foot">
    <div class="lp-foot-grid">
      <div>
        <div class="lp-brand">
          <span class="sb-logo"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 11a7 4 0 0 0-7-3.8C8 7.2 5 9 5 11.5c0 1.3.8 2.4 2 3.2V18h2.5l.5-1.4a10 10 0 0 0 4 0L14.5 18H17v-3.3c1.2-.8 2-2 2-3.2Z"/><path d="M5.5 10.5C4 10.2 3 9.4 3 8.5M9 7.2 8 5.5"/></svg></span>
          <span><span class="lp-name sb-name">DEC</span> <span class="lp-tag">· Dinheiro em Casa</span></span>
        </div>
        <p>Plataforma educativa de literacia financeira para o ensino secundário. Projeto académico ISTEC — Porto.</p>
      </div>
      <div>
        <h5>Plataforma</h5>
        <ul>
          <li><a href="#sobre">O que é a DEC</a></li>
          <li><a href="#funcionalidades">Funcionalidades</a></li>
          <li><a href="#perfis">Para alunos</a></li>
          <li><a href="#perfis">Para professores</a></li>
        </ul>
      </div>
      <div>
        <h5>Acesso</h5>
        <ul>
          <li><a asp-controller="Auth" asp-action="Login">Entrar na conta</a></li>
          <li><a asp-controller="Auth" asp-action="Register">Criar conta de aluno</a></li>
          <li><a asp-controller="Auth" asp-action="Register">Criar conta de professor</a></li>
          <li><a href="#como">Como funciona</a></li>
        </ul>
      </div>
      <div>
        <h5>Legal</h5>
        <ul>
          <li><a asp-controller="Home" asp-action="Privacy">Política de privacidade</a></li>
          <li><a href="#">Termos de utilização</a></li>
          <li><a href="#">Proteção de dados (RGPD)</a></li>
          <li><a href="#">Contactos</a></li>
        </ul>
      </div>
    </div>
    <div class="lp-foot-bar">
      <span>&copy; @DateTime.Now.Year DEC – Dinheiro em Casa. Projeto académico ISTEC.</span>
      <span>Literacia financeira · Ensino secundário · Portugal</span>
    </div>
  </footer>

  <script>
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
    document.querySelectorAll('a[href^="#"]').forEach(a=>{
      a.addEventListener('click', e=>{
        const id = a.getAttribute('href');
        if(id.length>1){ const t=document.querySelector(id); if(t){ e.preventDefault(); window.scrollTo({top: t.offsetTop-72, behavior:'smooth'}); } }
      });
    });
  </script>
</body>
</html>

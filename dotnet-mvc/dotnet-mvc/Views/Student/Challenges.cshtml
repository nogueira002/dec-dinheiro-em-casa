@model dotnet_mvc.ViewModels.Student.StudentChallengesIndexViewModel

@{
    ViewData["Title"] = "Desafios";
    ViewData["PageTitle"] = "Desafios";
    ViewData["Role"] = "Student";
    ViewData["ActiveMenu"] = "challenges";
    Layout = "_DashboardLayout";

    string StatusBadge(string key, string label) => key switch {
        "expired" => $"<span class=\"badge badge--danger\">{label}</span>",
        "pending" => $"<span class=\"badge badge--warning\">{label}</span>",
        "submitted" => $"<span class=\"badge badge--info\">{label}</span>",
        "graded" => $"<span class=\"badge badge--success\">{label}</span>",
        _ => $"<span class=\"badge badge--neutral\">{label}</span>"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Os teus desafios</h1>
        <p class="page-header__subtitle">Atividades atribuídas pelos professores.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" asp-controller="Student" asp-action="JoinCode">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 7h3a5 5 0 0 1 0 10h-3"/><path d="M9 17H6A5 5 0 0 1 6 7h3"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            Aderir por código
        </a>
    </div>
</div>

<div class="filters-bar">
    <span class="filters-bar__label">Estado:</span>
    <select class="filters-bar__select" disabled>
        <option>Todos</option>
    </select>
</div>

@if (Model.Challenges.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state__icon">🏆</div>
        <div class="empty-state__title">Sem desafios atribuídos</div>
        <p class="empty-state__text">
            Usa um código de turma ou de desafio para ficares associado aos conteúdos atribuídos.
        </p>
        <a class="btn btn--primary" asp-controller="Student" asp-action="JoinCode">Usar código de adesão</a>
    </div>
}
else
{
    <div class="grid grid--auto-md">
        @foreach (var c in Model.Challenges)
        {
            <article class="challenge-card">
                <div class="challenge-card__header">
                    <div>
                        <h3 class="challenge-card__title">@c.Title</h3>
                        <p class="text-sm text-muted mt-1">@c.Professor · @c.ClassroomName</p>
                    </div>
                    @Html.Raw(StatusBadge(c.StatusKey, c.StatusLabel))
                </div>

                <p class="text-sm" style="color: var(--color-gray-700);">@c.Description</p>

                <div class="challenge-card__meta">
                    <div class="scenario-card__row">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Entrega: <strong>@c.Deadline.ToString("dd 'de' MMMM 'de' yyyy")</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(c.Grade))
                    {
                        <div class="scenario-card__row">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            Nota: <strong style="color: var(--color-success);">@c.Grade</strong>
                        </div>
                    }
                </div>

                <div class="card__footer">
                    <button class="btn btn--outline btn--sm" disabled>Submissão em breve</button>
                </div>
            </article>
        }
    </div>
}

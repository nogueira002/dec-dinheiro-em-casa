@using System.Globalization
@model dotnet_mvc.ViewModels.Student.SimulationViewModel
@{
    ViewData["Title"] = "Simulações";
    Layout = "_DashboardLayout";
    var pt = CultureInfo.GetCultureInfo("pt-PT");
    string Money(decimal v) => string.Format(pt, "{0:N2} €", v);
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Simulações financeiras</h1>
        <p class="page-header__subtitle">Compara estratégias e descobre o impacto a longo prazo.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert--danger mb-6">
        <span>⚠️</span>
        <div>@Model.ErrorMessage</div>
    </div>
}

<div class="grid" style="grid-template-columns: 1fr 2fr; gap: var(--space-6);">

    @* ===== Formulário de simulação ===== *@
    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Parâmetros</h2>
                <p class="card__subtitle">Define a tua simulação</p>
            </div>
        </div>

        <form asp-controller="Student" asp-action="Simulations" method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label class="form-label" asp-for="ScenarioId">Cenário</label>
                <select class="form-select" asp-for="ScenarioId">
                    <option value="">— Sem cenário associado —</option>
                    @foreach (var scenario in Model.Scenarios)
                    {
                        <option value="@scenario.Id">@scenario.Name</option>
                    }
                </select>
                <span class="form-hint">Ao selecionar um cenário, os campos são preenchidos automaticamente a partir dos teus lançamentos.</span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="RendimentoMensal">Rendimento mensal (€)</label>
                <input class="form-control" type="number" step="0.01" min="0.01" asp-for="RendimentoMensal" />
                <span class="text-danger" asp-validation-for="RendimentoMensal"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="DespesasMensais">Despesas mensais (€)</label>
                <input class="form-control" type="number" step="0.01" min="0" asp-for="DespesasMensais" />
                <span class="text-danger" asp-validation-for="DespesasMensais"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="EncargosFixos">Encargos fixos (€)</label>
                <input class="form-control" type="number" step="0.01" min="0" asp-for="EncargosFixos" />
                <span class="text-danger" asp-validation-for="EncargosFixos"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="CapitalPoupanca">Capital para poupança (€)</label>
                <input class="form-control" type="number" step="0.01" min="0" asp-for="CapitalPoupanca" />
                <span class="text-danger" asp-validation-for="CapitalPoupanca"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Emprestimo">Empréstimo (€)</label>
                <input class="form-control" type="number" step="0.01" min="0" asp-for="Emprestimo" />
                <span class="text-danger" asp-validation-for="Emprestimo"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Meses">Período (meses)</label>
                <input class="form-control" type="number" asp-for="Meses" min="3" max="120" />
                <span class="text-danger" asp-validation-for="Meses"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Estratégia</label>
                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <label class="option-card">
                        <input type="radio" asp-for="Strategy" value="conservative" />
                        <div class="option-card__title">🛡️ Conservadora</div>
                        <div class="option-card__desc">Risco baixo · retorno previsível</div>
                    </label>
                    <label class="option-card">
                        <input type="radio" asp-for="Strategy" value="moderate" />
                        <div class="option-card__title">⚖️ Moderada</div>
                        <div class="option-card__desc">Equilíbrio entre risco e retorno</div>
                    </label>
                    <label class="option-card">
                        <input type="radio" asp-for="Strategy" value="aggressive" />
                        <div class="option-card__title">🚀 Agressiva</div>
                        <div class="option-card__desc">Risco alto · retorno potencial elevado</div>
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary btn--block">
                    Calcular simulação
                </button>
            </div>
        </form>
    </div>

    @* ===== Resultados ===== *@
    <div>
        @if (!Model.HasResult)
        {
            <div class="card">
                <div class="chart-placeholder">
                    <div class="chart-placeholder__label">
                        Preenche os parâmetros e calcula uma simulação para ver os resultados.
                    </div>
                </div>
            </div>
        }
        else
        {
            var result = Model.Result!;
            <div class="grid grid--2 mb-6">
                <div class="result-card">
                    <div class="result-card__label">Valor final acumulado</div>
                    <div class="result-card__value">
                        @(result.Capitalizacao is not null ? Money(result.Capitalizacao.MontanteFinal) : "—")
                    </div>
                    <div class="result-card__hint">
                        @(result.Capitalizacao is not null
                            ? $"Juros gerados: {Money(result.Capitalizacao.JurosGerados)} em {Model.Meses} meses"
                            : "Sem capital de poupança a simular")
                    </div>
                </div>
                <div class="result-card result-card--neutral">
                    <div class="result-card__label">Taxa de esforço</div>
                    <div class="result-card__value text-primary">
                        @(result.TaxaEsforco is not null ? $"{result.TaxaEsforco.TaxaEsforco.ToString("0.##", pt)}%" : "—")
                    </div>
                    <div class="result-card__hint">@(result.TaxaEsforco?.Classificacao ?? "—")</div>
                </div>
                <div class="result-card result-card--neutral">
                    <div class="result-card__label">Break-even</div>
                    <div class="result-card__value">
                        @(result.Projecao?.BreakEvenMes is int be ? $"{be} meses" : "Não atingido")
                    </div>
                    <div class="result-card__hint">Mês em que a poupança acumulada fica positiva</div>
                </div>
                <div class="result-card result-card--neutral">
                    <div class="result-card__label">Custo total do crédito</div>
                    <div class="result-card__value">
                        @(result.Credito is not null ? Money(result.Credito.CustoTotal) : "—")
                    </div>
                    <div class="result-card__hint">
                        @(result.Credito is not null
                            ? $"Prestação: {Money(result.Credito.PrestacaoMensal)}/mês · Juros: {Money(result.Credito.JurosTotais)}"
                            : "Sem empréstimo a simular")
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card__header">
                    <h2 class="card__title">Projeção de poupança</h2>
                    <span class="badge badge--info">Estratégia @result.Strategy</span>
                </div>

                @if (result.Projecao is not null)
                {
                    <div class="grid grid--2">
                        <div class="result-card result-card--neutral">
                            <div class="result-card__label">Poupança acumulada</div>
                            <div class="result-card__value">@Money(result.Projecao.PoupancaAcumulada)</div>
                            <div class="result-card__hint">ao fim de @Model.Meses meses (com inflação nas despesas)</div>
                        </div>
                        <div class="result-card result-card--neutral">
                            <div class="result-card__label">Saldo médio mensal</div>
                            <div class="result-card__value">@Money(result.Projecao.SaldoMedioMensal)</div>
                            <div class="result-card__hint">rendimento menos despesas ajustadas</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

@* ===== Histórico de simulações ===== *@
@if (Model.History is { Count: > 0 })
{
    <div class="card mt-6">
        <div class="card__header">
            <h2 class="card__title">Histórico de simulações</h2>
            <span class="badge badge--neutral">Últimas @Model.History.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Estratégia</th>
                        <th>Rendimento</th>
                        <th>Despesas</th>
                        <th>Meses</th>
                        <th>Taxa esforço</th>
                        <th>Montante final</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.History)
                    {
                        <tr>
                            <td class="text-sm text-muted">@h.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge badge--neutral">@h.StrategyLabel</span></td>
                            <td>@Money(h.RendimentoMensal)</td>
                            <td>@Money(h.DespesasMensais)</td>
                            <td>@h.Meses</td>
                            <td>
                                @if (h.TaxaEsforco.HasValue)
                                {
                                    <span>@h.TaxaEsforco.Value.ToString("0.##", pt)%</span>
                                    @if (!string.IsNullOrEmpty(h.TaxaEsforcoClassificacao))
                                    {
                                        <span class="text-muted text-sm"> · @h.TaxaEsforcoClassificacao</span>
                                    }
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td>@(h.MontanteFinal.HasValue ? Money(h.MontanteFinal.Value) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var sel = document.getElementById('ScenarioId');
            if (!sel) return;
            sel.addEventListener('change', async function () {
                var id = sel.value;
                if (!id) return;
                try {
                    var resp = await fetch('/Student/ScenarioQuickData/' + id);
                    if (!resp.ok) return;
                    var d = await resp.json();
                    var fill = function (fieldId, val) {
                        var el = document.getElementById(fieldId);
                        if (el) el.value = parseFloat(val).toFixed(2);
                    };
                    fill('RendimentoMensal', d.rendimentoMensal);
                    fill('DespesasMensais',  d.despesasMensais);
                    fill('EncargosFixos',    d.encargosFixos);
                    fill('CapitalPoupanca',  d.capitalPoupanca);
                } catch (e) {}
            });
        })();
    </script>
}

@model dotnet_mvc.ViewModels.Student.ScenarioEditorViewModel

@{
    var formAction = Model.IsEditMode ? "EditScenario" : "CreateScenario";
    var pageTitle = Model.IsEditMode ? "Editar cenário" : "Criar cenário";
    var pageSubtitle = Model.IsEditMode
        ? "Atualiza os parâmetros do cenário para manter a informação correta."
        : "Define o perfil da família que vais simular.";
    var submitLabel = Model.IsEditMode ? "Guardar alterações" : "Criar cenário";
    ViewData["Title"] = pageTitle;
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">@pageTitle</h1>
        <p class="page-header__subtitle">@pageSubtitle</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--ghost" asp-controller="Student" asp-action="Scenarios">← Voltar</a>
    </div>
</div>

<div style="max-width: 720px;">

    <form asp-controller="Student" asp-action="@formAction" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <div class="card mb-6">
            <div class="card__header">
                <div>
                    <h2 class="card__title">Identificação</h2>
                    <p class="card__subtitle">Define os dados-base da família virtual.</p>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Name" class="form-label form-label--required"></label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="Ex.: Família Silva"
                       required />
                <span asp-validation-for="Name" class="field-validation-error"></span>
                <span class="form-hint">Um nome curto e fácil de identificar.</span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Location" class="form-label form-label--required"></label>
                    <input asp-for="Location"
                           class="form-control"
                           placeholder="Ex.: Lisboa"
                           required />
                    <span asp-validation-for="Location" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MembersCount" class="form-label form-label--required"></label>
                    <input asp-for="MembersCount"
                           class="form-control"
                           type="number"
                           min="1"
                           max="10"
                           required />
                    <span asp-validation-for="MembersCount" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="InitialBalance" class="form-label form-label--required"></label>
                <input asp-for="InitialBalance"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0"
                       placeholder="0,00"
                       required />
                <span asp-validation-for="InitialBalance" class="field-validation-error"></span>
                <span class="form-hint">O valor disponível em conta no início do cenário.</span>
            </div>
        </div>

        <div class="card mb-6">
            <div class="card__header">
                <div>
                    <h2 class="card__title">Tipo de família</h2>
                    <p class="card__subtitle">Escolhe o perfil que melhor se aplica.</p>
                </div>
            </div>

            <div class="option-cards">
                <label class="option-card">
                    <input asp-for="ProfileType" type="radio" value="@dotnet_mvc.Models.ScenarioProfileType.StudentDeslocado" />
                    <div class="option-card__title">🎓 Estudante deslocado</div>
                    <div class="option-card__desc">A viver fora de casa para estudar.</div>
                </label>
                <label class="option-card">
                    <input asp-for="ProfileType" type="radio" value="@dotnet_mvc.Models.ScenarioProfileType.Casal" />
                    <div class="option-card__title">💑 Casal</div>
                    <div class="option-card__desc">Dois rendimentos, despesas partilhadas.</div>
                </label>
                <label class="option-card">
                    <input asp-for="ProfileType" type="radio" value="@dotnet_mvc.Models.ScenarioProfileType.Monoparental" />
                    <div class="option-card__title">👩‍👧 Família monoparental</div>
                    <div class="option-card__desc">Um adulto a cargo de um ou mais filhos.</div>
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary btn--lg">@submitLabel</button>
            <a class="btn btn--ghost" asp-controller="Student" asp-action="Scenarios">Cancelar</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

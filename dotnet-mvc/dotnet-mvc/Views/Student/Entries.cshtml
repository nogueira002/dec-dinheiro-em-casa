@using System.Globalization
@model dotnet_mvc.ViewModels.Student.EntriesIndexViewModel
@{
    ViewData["Title"] = "Lançamentos";
    Layout = "_DashboardLayout";
    var pt = CultureInfo.GetCultureInfo("pt-PT");
    string Money(decimal v) => string.Format(pt, "{0:N2} €", v);
    var balance = Model.Balance;
    var balanceColor = balance >= 0 ? "var(--color-success)" : "var(--color-danger)";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Lançamentos financeiros</h1>
        @if (Model.SelectedScenarioId.HasValue)
        {
            var sc = Model.AvailableScenarios.FirstOrDefault(s => s.Id == Model.SelectedScenarioId);
            <p class="page-header__subtitle">Cenário: <strong>@(sc?.Name ?? "—")</strong></p>
        }
        else
        {
            <p class="page-header__subtitle">Seleciona um cenário para ver os lançamentos.</p>
        }
    </div>
</div>

@* Seletor de cenário *@
@if (!Model.SelectedScenarioId.HasValue)
{
    <div class="card mb-6">
        <div class="card__header">
            <h2 class="card__title">Escolhe um cenário</h2>
        </div>
        @if (Model.AvailableScenarios.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__icon">📂</div>
                <div class="empty-state__title">Ainda não tens cenários</div>
                <p class="empty-state__text">Cria primeiro um cenário familiar na secção Cenários.</p>
                <a asp-controller="Student" asp-action="Scenarios" class="btn btn--primary">Ir para Cenários</a>
            </div>
        }
        else
        {
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-3);">
                @foreach (var s in Model.AvailableScenarios)
                {
                    <a asp-controller="Student" asp-action="Entries" asp-route-scenarioId="@s.Id"
                       class="btn btn--outline">@s.Name</a>
                }
            </div>
        }
    </div>
}
else
{
    @* Stat cards *@
    <div class="grid grid--3 mb-6">
        <div class="stat-card">
            <div class="stat-card__icon stat-card__icon--success">↑</div>
            <div class="stat-card__content">
                <div class="stat-card__label">Rendimentos</div>
                <div class="stat-card__value">@Money(Model.TotalIncome)</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card__icon stat-card__icon--danger">↓</div>
            <div class="stat-card__content">
                <div class="stat-card__label">Despesas</div>
                <div class="stat-card__value">@Money(Model.TotalExpense)</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card__icon">€</div>
            <div class="stat-card__content">
                <div class="stat-card__label">Saldo</div>
                <div class="stat-card__value" style="color: @balanceColor;">@Money(balance)</div>
            </div>
        </div>
    </div>

    @* Formulário de novo lançamento *@
    <div class="card mb-6">
        <div class="card__header">
            <h2 class="card__title">Novo lançamento</h2>
        </div>
        <form asp-controller="Student" asp-action="AddEntry" asp-route-scenarioId="@Model.SelectedScenarioId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label form-label--required" asp-for="Form.EntryType">Tipo</label>
                    <select class="form-select" asp-for="Form.EntryType" id="entryTypeSelect">
                        <option value="Income">Rendimento</option>
                        <option value="Expense">Despesa</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label form-label--required" asp-for="Form.Category">Categoria</label>
                    <select class="form-select" asp-for="Form.Category" id="categorySelect">
                        @foreach (var c in dotnet_mvc.ViewModels.Student.CreateEntryViewModel.IncomeCategories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="Form.Category"></span>
                </div>
                <div class="form-group">
                    <label class="form-label form-label--required" asp-for="Form.Amount">Valor (€)</label>
                    <input class="form-control" type="number" step="0.01" min="0.01" asp-for="Form.Amount" placeholder="0,00" />
                    <span class="text-danger" asp-validation-for="Form.Amount"></span>
                </div>
                <div class="form-group">
                    <label class="form-label form-label--required" asp-for="Form.Month">Mês</label>
                    <select class="form-select" asp-for="Form.Month">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == Model.Form.Month)">
                                @dotnet_mvc.ViewModels.Student.CreateEntryViewModel.MonthNames[m]
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label form-label--required" asp-for="Form.Year">Ano</label>
                    <input class="form-control" type="number" asp-for="Form.Year" min="2000" max="2100" />
                    <span class="text-danger" asp-validation-for="Form.Year"></span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Adicionar</button>
            </div>
        </form>
    </div>

    @* Filtro por tipo *@
    <div class="filters-bar mb-4">
        <span class="filters-bar__label">Filtrar:</span>
        <a asp-controller="Student" asp-action="Entries"
           asp-route-scenarioId="@Model.SelectedScenarioId"
           class="btn btn--sm @(Model.TypeFilter == null ? "btn--primary" : "btn--ghost")">Todos</a>
        <a asp-controller="Student" asp-action="Entries"
           asp-route-scenarioId="@Model.SelectedScenarioId" asp-route-type="Income"
           class="btn btn--sm @(Model.TypeFilter == "Income" ? "btn--primary" : "btn--ghost")">Rendimentos</a>
        <a asp-controller="Student" asp-action="Entries"
           asp-route-scenarioId="@Model.SelectedScenarioId" asp-route-type="Expense"
           class="btn btn--sm @(Model.TypeFilter == "Expense" ? "btn--primary" : "btn--ghost")">Despesas</a>
    </div>

    @* Tabela *@
    @if (Model.Entries.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state__icon">📊</div>
            <div class="empty-state__title">Sem lançamentos@(Model.TypeFilter != null ? " para este filtro" : "")</div>
            <p class="empty-state__text">Adiciona o primeiro lançamento financeiro acima.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Categoria</th>
                            <th>Valor</th>
                            <th>Mês</th>
                            <th>Ano</th>
                            <th style="text-align: right;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Entries)
                        {
                            <tr>
                                <td>
                                    @if (e.IsIncome)
                                    {
                                        <span class="badge badge--success badge--dot">Rendimento</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--danger badge--dot">Despesa</span>
                                    }
                                </td>
                                <td><strong>@e.Category</strong></td>
                                <td style="font-weight: 600; color: @(e.IsIncome ? "var(--color-success)" : "var(--color-danger)");">
                                    @(e.IsIncome ? "+" : "−") @Money(e.Amount)
                                </td>
                                <td>@e.MonthName</td>
                                <td>@e.Year</td>
                                <td style="text-align: right;">
                                    <form asp-controller="Student" asp-action="DeleteEntry"
                                          asp-route-scenarioId="@Model.SelectedScenarioId"
                                          asp-route-entryId="@e.Id" method="post"
                                          onsubmit="return confirm('Apagar este lançamento?');"
                                          style="display:inline;">
                                        <button type="submit" class="btn btn--ghost btn--sm text-danger">Apagar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var incomeCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dotnet_mvc.ViewModels.Student.CreateEntryViewModel.IncomeCategories));
            var expenseCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dotnet_mvc.ViewModels.Student.CreateEntryViewModel.ExpenseCategories));
            var typeSelect = document.getElementById('entryTypeSelect');
            var catSelect = document.getElementById('categorySelect');

            function updateCategories() {
                var cats = typeSelect.value === 'Income' ? incomeCategories : expenseCategories;
                catSelect.innerHTML = '';
                cats.forEach(function (c) {
                    var opt = document.createElement('option');
                    opt.value = c;
                    opt.textContent = c;
                    catSelect.appendChild(opt);
                });
            }

            if (typeSelect) {
                typeSelect.addEventListener('change', updateCategories);
            }
        })();
    </script>
}

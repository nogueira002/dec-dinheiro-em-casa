@using System.Globalization
@model dotnet_mvc.ViewModels.Student.EntriesIndexViewModel

@{
    ViewData["Title"]      = "Lançamentos";
    ViewData["PageTitle"]  = "Lançamentos financeiros";
    ViewData["Role"]       = "Student";
    ViewData["ActiveMenu"] = "entries";
    Layout = "_DashboardLayout";

    var pt = CultureInfo.GetCultureInfo("pt-PT");
    string Money(decimal v) => string.Format(pt, "{0:N2} €", v);
    var balance      = Model.Balance;
    var balanceColor = balance >= 0 ? "var(--color-success)" : "var(--color-danger)";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Lançamentos financeiros</h1>
        @if (Model.SelectedScenarioId.HasValue)
        {
            var sc = Model.AvailableScenarios.FirstOrDefault(s => s.Id == Model.SelectedScenarioId);
            <p class="page-header__subtitle">Cenário: <strong>@(sc?.Name ?? "—")</strong></p>
        }
        else
        {
            <p class="page-header__subtitle">Seleciona um cenário para gerir os seus lançamentos.</p>
        }
    </div>
    @if (Model.SelectedScenarioId.HasValue)
    {
        <div class="page-header__actions">
            <a class="btn btn--ghost btn--sm" asp-controller="Student" asp-action="Entries">Mudar cenário</a>
        </div>
    }
</div>

@if (!Model.SelectedScenarioId.HasValue)
{
    @* Seletor de cenário *@
    @if (Model.AvailableScenarios.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <h3 class="empty-state__title">Ainda não tens cenários</h3>
            <p class="empty-state__text">Cria primeiro um cenário familiar na secção Cenários para depois lhe adicionar lançamentos.</p>
            <a asp-controller="Student" asp-action="Scenarios" class="btn btn--primary">Ir para Cenários</a>
        </div>
    }
    else
    {
        <div class="scenario-picker">
            <p class="scenario-picker__label">Escolhe o cenário para gerir os lançamentos:</p>
            <div class="scenario-picker__grid">
                @foreach (var s in Model.AvailableScenarios)
                {
                    <a class="scenario-picker-card" asp-controller="Student" asp-action="Entries" asp-route-scenarioId="@s.Id">
                        <div class="scenario-picker-card__icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                        </div>
                        <div class="scenario-picker-card__body">
                            <strong>@s.Name</strong>
                            <span>@s.Location</span>
                        </div>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--muted-fg); flex-shrink:0;">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </a>
                }
            </div>
        </div>
    }
}
else
{
    @* KPIs *@
    <div class="grid grid--3 mb-6">
        <div class="stat-card stat-card--accent-success">
            <div class="stat-card__icon stat-card__icon--success">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="18 15 12 9 6 15"/>
                </svg>
            </div>
            <div class="stat-card__content">
                <div class="stat-card__label">Rendimentos</div>
                <div class="stat-card__value">@Money(Model.TotalIncome)</div>
                <div class="stat-card__hint">Total do período</div>
            </div>
        </div>

        <div class="stat-card stat-card--accent-danger">
            <div class="stat-card__icon stat-card__icon--danger">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            <div class="stat-card__content">
                <div class="stat-card__label">Despesas</div>
                <div class="stat-card__value">@Money(Model.TotalExpense)</div>
                <div class="stat-card__hint">Total do período</div>
            </div>
        </div>

        <div class="stat-card @(balance >= 0 ? "stat-card--accent-success" : "stat-card--accent-danger")">
            <div class="stat-card__icon @(balance >= 0 ? "stat-card__icon--success" : "stat-card__icon--danger")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <div class="stat-card__content">
                <div class="stat-card__label">Saldo</div>
                <div class="stat-card__value" style="color: @balanceColor;">@Money(balance)</div>
                <div class="stat-card__hint">Rendimentos − Despesas</div>
            </div>
        </div>
    </div>

    @* Formulário *@
    <div class="card mb-6" id="entryFormCard">
        <div class="card__header">
            <div>
                <h2 class="card__title" id="entryFormTitle">Novo lançamento</h2>
                <p class="card__subtitle">Regista uma receita ou despesa neste cenário.</p>
            </div>
        </div>

        <form id="entryForm"
              action="@Url.Action("AddEntry", "Student", new { scenarioId = Model.SelectedScenarioId })"
              data-add-url="@Url.Action("AddEntry", "Student", new { scenarioId = Model.SelectedScenarioId })"
              data-edit-base-url="@Url.Action("UpdateEntry", "Student", new { scenarioId = Model.SelectedScenarioId })&entryId="
              method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-4"></div>

            <div class="form-row mb-4">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label form-label--required" asp-for="Form.EntryType">Tipo</label>
                    <select class="form-select" asp-for="Form.EntryType" id="entryTypeSelect">
                        <option value="Income">Rendimento</option>
                        <option value="Expense">Despesa</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label form-label--required" asp-for="Form.Category">Categoria</label>
                    <select class="form-select" asp-for="Form.Category" id="categorySelect">
                        @foreach (var c in dotnet_mvc.ViewModels.Student.CreateEntryViewModel.IncomeCategories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <span class="field-validation-error" asp-validation-for="Form.Category"></span>
                </div>
            </div>

            <div class="form-row-3 mb-4">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label form-label--required" asp-for="Form.Amount">Valor (€)</label>
                    <div class="input-addon">
                        <span class="input-addon__prefix">€</span>
                        <input class="form-control input-addon__input" type="number" step="0.01" min="0.01" asp-for="Form.Amount" placeholder="0,00" />
                    </div>
                    <span class="field-validation-error" asp-validation-for="Form.Amount"></span>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label form-label--required" asp-for="Form.Month">Mês</label>
                    <select class="form-select" asp-for="Form.Month">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == Model.Form.Month)">
                                @dotnet_mvc.ViewModels.Student.CreateEntryViewModel.MonthNames[m]
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label form-label--required" asp-for="Form.Year">Ano</label>
                    <input class="form-control" type="number" asp-for="Form.Year" min="2000" max="2100" />
                    <span class="field-validation-error" asp-validation-for="Form.Year"></span>
                </div>
            </div>

            <div id="recurringRow" style="display:none; margin-bottom: 1.25rem;">
                <label class="form-check-label">
                    <input type="checkbox" asp-for="Form.IsRecurring" class="form-check-input" />
                    <span>Encargo fixo mensal — ex: renda, seguro, prestação</span>
                </label>
                <p class="form-hint" style="margin-left: 1.5rem;">Esta despesa será contabilizada como encargo fixo nas simulações financeiras.</p>
            </div>

            <div class="form-actions">
                <button type="submit" id="entrySubmitBtn" class="btn btn--primary">Adicionar lançamento</button>
                <button type="button" id="entryCancelBtn" class="btn btn--ghost" style="display:none" onclick="cancelEditEntry()">Cancelar edição</button>
            </div>
        </form>
    </div>

    @* Filtros *@
    <div class="filters-bar mb-4">
        <span class="filters-bar__label">Filtrar:</span>
        <a asp-controller="Student" asp-action="Entries" asp-route-scenarioId="@Model.SelectedScenarioId"
           class="btn btn--sm @(Model.TypeFilter == null ? "btn--primary" : "btn--ghost")">Todos</a>
        <a asp-controller="Student" asp-action="Entries" asp-route-scenarioId="@Model.SelectedScenarioId" asp-route-type="Income"
           class="btn btn--sm @(Model.TypeFilter == "Income" ? "btn--primary" : "btn--ghost")">Rendimentos</a>
        <a asp-controller="Student" asp-action="Entries" asp-route-scenarioId="@Model.SelectedScenarioId" asp-route-type="Expense"
           class="btn btn--sm @(Model.TypeFilter == "Expense" ? "btn--primary" : "btn--ghost")">Despesas</a>
    </div>

    @* Tabela *@
    @if (Model.Entries.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <h3 class="empty-state__title">Sem lançamentos@(Model.TypeFilter != null ? " para este filtro" : "")</h3>
            <p class="empty-state__text">Usa o formulário acima para registar o primeiro lançamento financeiro.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Categoria</th>
                            <th>Valor</th>
                            <th>Período</th>
                            <th>Fixo</th>
                            <th style="text-align:right;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Entries)
                        {
                            <tr>
                                <td>
                                    @if (e.IsIncome)
                                    {
                                        <span class="badge badge--success badge--dot">Rendimento</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--danger badge--dot">Despesa</span>
                                    }
                                </td>
                                <td><strong>@e.Category</strong></td>
                                <td style="font-weight:600; color:@(e.IsIncome ? "var(--color-success)" : "var(--color-danger)");">
                                    @(e.IsIncome ? "+" : "−") @Money(e.Amount)
                                </td>
                                <td>@e.MonthName @e.Year</td>
                                <td>
                                    @if (!e.IsIncome && e.IsRecurring)
                                    {
                                        <span class="badge badge--warning" title="Encargo fixo mensal">Fixo</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--color-gray-400)">—</span>
                                    }
                                </td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <button type="button" class="btn btn--ghost btn--sm"
                                            onclick="editEntry(@e.Id,'@(e.IsIncome ? "Income" : "Expense")','@e.Category.Replace("'","\\'")',@e.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),@e.Month,@e.Year,@(e.IsRecurring && !e.IsIncome ? "true" : "false"))">
                                        Editar
                                    </button>
                                    <form asp-controller="Student" asp-action="DeleteEntry"
                                          asp-route-scenarioId="@Model.SelectedScenarioId"
                                          asp-route-entryId="@e.Id"
                                          method="post"
                                          onsubmit="return confirm('Apagar este lançamento?');"
                                          style="display:inline;">
                                        <button type="submit" class="btn btn--ghost btn--sm text-danger">Apagar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var incomeCategories  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dotnet_mvc.ViewModels.Student.CreateEntryViewModel.IncomeCategories));
        var expenseCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dotnet_mvc.ViewModels.Student.CreateEntryViewModel.ExpenseCategories));

        var typeSelect   = document.getElementById('entryTypeSelect');
        var catSelect    = document.getElementById('categorySelect');
        var recurringRow = document.getElementById('recurringRow');
        var entryForm    = document.getElementById('entryForm');
        var formTitle    = document.getElementById('entryFormTitle');
        var submitBtn    = document.getElementById('entrySubmitBtn');
        var cancelBtn    = document.getElementById('entryCancelBtn');

        function updateCategories(keepSelected) {
            var isExpense = typeSelect.value === 'Expense';
            var cats = isExpense ? expenseCategories : incomeCategories;
            var current = catSelect.value;
            catSelect.innerHTML = '';
            cats.forEach(function (c) {
                var opt = document.createElement('option');
                opt.value = c;
                opt.textContent = c;
                catSelect.appendChild(opt);
            });
            if (keepSelected && cats.indexOf(current) >= 0) catSelect.value = current;
            if (recurringRow) {
                recurringRow.style.display = isExpense ? 'block' : 'none';
                if (!isExpense) {
                    var cb = recurringRow.querySelector('input[type=checkbox]');
                    if (cb) cb.checked = false;
                }
            }
        }

        if (typeSelect) {
            typeSelect.addEventListener('change', function () { updateCategories(false); });
            updateCategories(false);
        }

        function editEntry(id, type, category, amount, month, year, recurring) {
            typeSelect.value = type;
            updateCategories(false);
            catSelect.value = category;
            document.querySelector('[name="Form.Amount"]').value = amount;
            document.querySelector('[name="Form.Month"]').value = month;
            document.querySelector('[name="Form.Year"]').value = year;
            var cb = recurringRow ? recurringRow.querySelector('input[type=checkbox]') : null;
            if (cb) cb.checked = recurring;

            entryForm.action = entryForm.dataset.editBaseUrl + id;
            formTitle.textContent = 'Editar lançamento';
            submitBtn.textContent = 'Guardar alterações';
            cancelBtn.style.display = '';
            entryForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function cancelEditEntry() {
            entryForm.action = entryForm.dataset.addUrl;
            entryForm.reset();
            updateCategories(false);
            formTitle.textContent = 'Novo lançamento';
            submitBtn.textContent = 'Adicionar lançamento';
            cancelBtn.style.display = 'none';
        }
    </script>
}

@using System.Globalization
@model dotnet_mvc.ViewModels.Student.StudentDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["Role"] = "Student";
    ViewData["ActiveMenu"] = "dashboard";
    Layout = "_DashboardLayout";

    string StatusBadge(string key, string label) => key switch
    {
        "expired" => $"<span class=\"badge badge--danger\">{label}</span>",
        "pending" => $"<span class=\"badge badge--warning\">{label}</span>",
        "submitted" => $"<span class=\"badge badge--info\">{label}</span>",
        "graded" => $"<span class=\"badge badge--success\">{label}</span>",
        _ => $"<span class=\"badge badge--neutral\">{label}</span>"
    };

    string WidthValue(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Olá, @(User.Identity?.Name ?? "aluno") 👋</h1>
        <p class="page-header__subtitle">Aqui está um resumo dos teus cenários e dos resultados pedagógicos mais recentes.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" asp-controller="Student" asp-action="JoinCode">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 7h3a5 5 0 0 1 0 10h-3"/><path d="M9 17H6A5 5 0 0 1 6 7h3"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            Aderir por código
        </a>
        <a class="btn btn--outline" asp-controller="Student" asp-action="CreateScenario">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Novo cenário
        </a>
        <a class="btn btn--ghost" asp-controller="Student" asp-action="Challenges">
            Ver desafios
        </a>
    </div>
</div>

<div class="grid grid--4 mb-8">
    <div class="stat-card">
        <div class="stat-card__icon">🏠</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Cenários</div>
            <div class="stat-card__value">@Model.ScenarioCount</div>
            <div class="stat-card__hint">Maior saldo: @Model.HighestInitialBalanceDisplay@(string.IsNullOrWhiteSpace(Model.HighestInitialBalanceScenarioName) ? string.Empty : $" · {Model.HighestInitialBalanceScenarioName}")</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon">EUR</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Saldo inicial médio</div>
            <div class="stat-card__value">@Model.AverageInitialBalanceDisplay</div>
            <div class="stat-card__hint">Comparação entre os teus cenários</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--info">★</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Desafios</div>
            <div class="stat-card__value">@Model.ChallengeCount</div>
            <div class="stat-card__hint">@Model.PendingChallengesCount pendentes · @Model.ReviewedChallengesCount avaliados</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--success">✓</div>
        <div class="stat-card__content">
            <div class="stat-card__label">Taxa de entrega</div>
            <div class="stat-card__value">@Model.CompletionRateLabel</div>
            <div class="stat-card__hint">Média das avaliações: @Model.AverageGradeDisplay</div>
        </div>
    </div>
</div>

<div class="results-layout mb-8">
    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Comparação de saldos iniciais</h2>
                <p class="card__subtitle">Os teus cenários mais relevantes lado a lado.</p>
            </div>
            <a class="btn btn--ghost btn--sm" asp-controller="Student" asp-action="Scenarios">Ver todos</a>
        </div>

        @if (Model.ScenarioComparisons.Count == 0)
        {
            <p class="text-sm text-muted">Cria o teu primeiro cenário para começar a comparar resultados no dashboard.</p>
        }
        else
        {
            <canvas id="chartSaldos" height="180"></canvas>
        }
    </div>

    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Estado dos desafios</h2>
                <p class="card__subtitle">Resumo rápido das tuas entregas.</p>
            </div>
        </div>

        <canvas id="chartDesafios" height="220"></canvas>

        <div class="progress-label" style="margin-top: var(--space-5);">
            <span>Entregas concluídas</span>
            <strong>@Model.CompletionRateLabel</strong>
        </div>
        <div class="progress progress--lg">
            <div class="progress__bar @(Model.ReviewedChallengesCount > 0 ? "progress__bar--success" : Model.SubmittedChallengesCount > 0 ? "progress__bar--warning" : string.Empty)"
                 style="width: @(WidthValue(Model.CompletionRatePercent))%;"></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.UpcomingDeadlineText))
        {
            <div class="alert alert--warning" style="margin-top: var(--space-5); margin-bottom: 0;">
                <span>!</span>
                <div>
                    <strong>Próxima entrega</strong><br />
                    @Model.UpcomingDeadlineText
                </div>
            </div>
        }
    </div>
</div>

<div class="grid grid--auto-md">
    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Resultados dos desafios</h2>
                <p class="card__subtitle">Comparação entre estado, prazo e nota.</p>
            </div>
        </div>

        @if (Model.ChallengeResults.Count == 0)
        {
            <p class="text-sm text-muted">Ainda não tens desafios atribuídos. Usa um código de adesão para começares.</p>
        }
        else
        {
            <div class="table-wrapper">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Desafio</th>
                                <th>Estado</th>
                                <th>Nota</th>
                                <th>Prazo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var challenge in Model.ChallengeResults)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <strong>@challenge.Title</strong>
                                            <div class="text-sm text-muted">@challenge.ClassroomName · @challenge.Professor</div>
                                        </div>
                                    </td>
                                    <td>@Html.Raw(StatusBadge(challenge.StatusKey, challenge.StatusLabel))</td>
                                    <td>@(challenge.GradeDisplay ?? "—")</td>
                                    <td>
                                        <div>@challenge.Deadline.ToString("dd/MM/yyyy")</div>
                                        @if (challenge.SubmittedAtUtc.HasValue)
                                        {
                                            <div class="text-sm text-muted">Entregue @challenge.SubmittedAtUtc.Value.ToString("dd/MM")</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card__footer">
            <a class="btn btn--ghost btn--sm" asp-controller="Student" asp-action="Challenges">Abrir área de desafios →</a>
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Cenários recentes</h2>
                <p class="card__subtitle">Consulta rápida para análise comparável.</p>
            </div>
        </div>

        @if (Model.RecentScenarios.Count == 0)
        {
            <p class="text-sm text-muted">Ainda não criaste cenários. Quando criares, eles passam a aparecer aqui com dados resumidos.</p>
        }
        else
        {
            <div class="table-wrapper">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Cenário</th>
                                <th>Perfil</th>
                                <th>Saldo</th>
                                <th>Atualizado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var scenario in Model.RecentScenarios)
                            {
                                <tr>
                                    <td>
                                        <div>
                                            <strong>@scenario.Name</strong>
                                            <div class="text-sm text-muted">@scenario.Location</div>
                                        </div>
                                    </td>
                                    <td><span class="badge badge--primary">@scenario.ProfileTypeLabel</span></td>
                                    <td>@scenario.InitialBalanceDisplay</td>
                                    <td>@scenario.UpdatedAtUtc.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card__footer">
            <a class="btn btn--ghost btn--sm" asp-controller="Student" asp-action="Scenarios">Gerir cenários →</a>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Gráfico de barras — saldos iniciais por cenário
    @if (Model.ScenarioComparisons.Count > 0)
    {
        <text>
        (function () {
            var labels  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScenarioComparisons.Select(x => x.Name)));
            var valores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScenarioComparisons.Select(x => x.InitialBalance)));

            new Chart(document.getElementById('chartSaldos'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Saldo inicial (€)',
                        data: valores,
                        backgroundColor: 'rgba(99, 102, 241, 0.7)',
                        borderColor: 'rgba(99, 102, 241, 1)',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => ctx.parsed.y.toLocaleString('pt-PT', { style: 'currency', currency: 'EUR' })
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: val => val.toLocaleString('pt-PT', { style: 'currency', currency: 'EUR' })
                            }
                        }
                    }
                }
            });
        })();
        </text>
    }

    // Gráfico donut — estado dos desafios
    (function () {
        var totais = [
            @Model.PendingChallengesCount,
            @(Model.SubmittedChallengesCount - Model.ReviewedChallengesCount),
            @Model.ReviewedChallengesCount,
            @Model.ExpiredChallengesCount
        ];

        new Chart(document.getElementById('chartDesafios'), {
            type: 'doughnut',
            data: {
                labels: ['Pendentes', 'Submetidos', 'Avaliados', 'Expirados'],
                datasets: [{
                    data: totais,
                    backgroundColor: [
                        'rgba(245, 158, 11, 0.8)',
                        'rgba(59, 130, 246, 0.8)',
                        'rgba(16, 185, 129, 0.8)',
                        'rgba(239, 68, 68, 0.8)'
                    ],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                cutout: '65%',
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    })();
</script>
}

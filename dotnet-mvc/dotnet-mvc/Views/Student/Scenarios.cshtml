@using System.Globalization
@model dotnet_mvc.ViewModels.Student.StudentScenariosIndexViewModel

@{
    ViewData["Title"]      = "Cenários familiares";
    ViewData["PageTitle"]  = "Cenários familiares";
    ViewData["Role"]       = "Student";
    ViewData["ActiveMenu"] = "scenarios";
    Layout = "_DashboardLayout";

    var pt = CultureInfo.GetCultureInfo("pt-PT");
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Cenários familiares</h1>
        <p class="page-header__subtitle">Cria perfis diferentes e descobre o impacto das tuas decisões financeiras.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" asp-controller="Student" asp-action="CreateScenario">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Criar cenário
        </a>
    </div>
</div>

@if (Model.Scenarios.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state__icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
        </div>
        <h3 class="empty-state__title">Ainda não tens cenários criados</h3>
        <p class="empty-state__text">
            Cria o teu primeiro cenário familiar e começa a explorar como
            diferentes contextos influenciam as decisões financeiras.
        </p>
        <a class="btn btn--primary" asp-controller="Student" asp-action="CreateScenario">
            Criar primeiro cenário
        </a>
    </div>
}
else
{
    <div class="scenarios-grid">
        @foreach (var s in Model.Scenarios)
        {
            <article class="scenario-item">
                <!-- Cabeçalho -->
                <div class="scenario-item__head">
                    <div class="scenario-item__icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                    </div>
                    <div class="scenario-item__meta">
                        <span class="badge badge--primary">@s.ProfileTypeLabel</span>
                    </div>
                </div>

                <!-- Nome e localização -->
                <div class="scenario-item__body">
                    <h3 class="scenario-item__title">@s.Name</h3>
                    <div class="scenario-item__details">
                        <span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            @s.Location
                        </span>
                        <span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                            @s.MembersCount membro@(s.MembersCount == 1 ? "" : "s")
                        </span>
                    </div>
                </div>

                <!-- Saldo -->
                <div class="scenario-item__balance">
                    <span class="scenario-item__balance-label">Saldo inicial</span>
                    <span class="scenario-item__balance-value">@string.Format(pt, "{0:N2} €", s.InitialBalance)</span>
                </div>

                <!-- Ações -->
                <div class="scenario-item__footer">
                    <div class="scenario-item__actions">
                        <a class="btn btn--primary btn--sm" asp-controller="Student" asp-action="EditScenario" asp-route-id="@s.Id">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Editar
                        </a>
                        <a class="btn btn--outline btn--sm" asp-controller="Student" asp-action="Entries" asp-route-scenarioId="@s.Id">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            Lançamentos
                        </a>
                        <a class="btn btn--outline btn--sm" asp-controller="Student" asp-action="Objectives" asp-route-scenarioId="@s.Id">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                            Objetivos
                        </a>
                    </div>
                    <span class="scenario-item__date">Criado em @s.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                </div>
            </article>
        }
    </div>
}

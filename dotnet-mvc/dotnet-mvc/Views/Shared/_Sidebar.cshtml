@using System.Security.Claims
@using dotnet_mvc.Extensions
@using dotnet_mvc.Security

@*
    Partial da sidebar para áreas autenticadas
    Variáveis (via ViewData):
      - "Role": "Student" | "Professor" | "Admin"
      - "ActiveMenu": identificador da entrada ativa (ex: "dashboard")
      - "UserName" / "UserRoleLabel": opcional para o footer
*@
@{
    var currentRole = Context.User.FindFirstValue(ClaimTypes.Role);
    var role = (ViewData["Role"] as string) ?? UserRoles.Normalize(currentRole);
    var active = (ViewData["ActiveMenu"] as string) ?? "";
    var userName = Context.User.Identity?.IsAuthenticated == true
        ? Context.User.GetDisplayName()
        : (ViewData["UserName"] as string) ?? "Utilizador";
    var userRoleLabel = Context.User.Identity?.IsAuthenticated == true
        ? Context.User.GetRoleLabel()
        : (ViewData["UserRoleLabel"] as string) ?? UserRoles.ToDisplayLabel(role);

    string Cls(string id) => active == id ? "sidebar__link sidebar__link--active" : "sidebar__link";
}

<aside class="sidebar" data-sidebar>

    <a class="sidebar__brand" asp-controller="Home" asp-action="Index">
        <span class="sidebar__logo">DEC</span>
        <div>
            <div class="sidebar__brand-text">Dinheiro em Casa</div>
            <div class="sidebar__brand-tag">ISTEC</div>
        </div>
    </a>

    @if (role == "Student")
    {
        <div class="sidebar__section">
            <div class="sidebar__section-title">Principal</div>
            <nav class="sidebar__nav">
                <a class="@Cls("dashboard")" asp-controller="Student" asp-action="Dashboard">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a>
                <a class="@Cls("scenarios")" asp-controller="Student" asp-action="Scenarios">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Cenários familiares
                </a>
                <a class="@Cls("entries")" asp-controller="Student" asp-action="Entries">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Lançamentos
                </a>
                <a class="@Cls("simulations")" asp-controller="Student" asp-action="Simulations">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    Simulações
                </a>
                <a class="@Cls("objectives")" asp-controller="Student" asp-action="Objectives">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    Objetivos
                </a>
                <a class="@Cls("challenges")" asp-controller="Student" asp-action="Challenges">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    Desafios
                </a>
                <a class="@Cls("join-code")" asp-controller="Student" asp-action="JoinCode">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 1 7.07 0l1.41 1.41a5 5 0 1 1-7.07 7.07L10 20"/><path d="M14 11a5 5 0 0 1-7.07 0L5.52 9.59A5 5 0 0 1 12.59 2.52L14 4"/><line x1="8" y1="16" x2="16" y2="8"/></svg>
                    Aderir por código
                </a>
            </nav>
        </div>
    }
    else if (role == "Professor")
    {
        <div class="sidebar__section">
            <div class="sidebar__section-title">Principal</div>
            <nav class="sidebar__nav">
                <a class="@Cls("dashboard")" asp-controller="Professor" asp-action="Dashboard">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a>
                <a class="@Cls("classes")" asp-controller="Professor" asp-action="Classes">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Turmas
                </a>
                <a class="@Cls("submissions")" asp-controller="Professor" asp-action="Submissions">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                    Submissões
                </a>
                <a class="@Cls("progress")" asp-controller="Professor" asp-action="Progress">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Progresso
                </a>
            </nav>
        </div>
        <div class="sidebar__section">
            <div class="sidebar__section-title">Atalhos</div>
            <nav class="sidebar__nav">
                <a class="@Cls("create-challenge")" asp-controller="Professor" asp-action="CreateChallenge">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Criar desafio
                </a>
                <a class="@Cls("create-class")" asp-controller="Professor" asp-action="CreateClass">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Criar turma
                </a>
            </nav>
        </div>
    }
    else if (role == "Admin")
    {
        <div class="sidebar__section">
            <div class="sidebar__section-title">Administração</div>
            <nav class="sidebar__nav">
                <a class="@Cls("dashboard")" asp-controller="Admin" asp-action="Dashboard">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Dashboard
                </a>
                <a class="@Cls("users")" asp-controller="Admin" asp-action="Users">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Utilizadores
                </a>
                <a class="@Cls("monitoring")" asp-controller="Admin" asp-action="Monitoring">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    Monitorização
                </a>
            </nav>
        </div>
        <div class="sidebar__section">
            <div class="sidebar__section-title">Académico</div>
            <nav class="sidebar__nav">
                <a class="@Cls("classes")" asp-controller="Professor" asp-action="Classes">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Turmas
                </a>
                <a class="@Cls("create-class")" asp-controller="Professor" asp-action="CreateClass">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Criar turma
                </a>
                <a class="@Cls("create-challenge")" asp-controller="Professor" asp-action="CreateChallenge">
                    <svg class="sidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Criar desafio
                </a>
            </nav>
        </div>
    }

    <div class="sidebar__user">
        <div class="sidebar__avatar">@(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")</div>
        <div class="sidebar__user-info">
            <div class="sidebar__user-name">@userName</div>
            <div class="sidebar__user-role">@userRoleLabel</div>
        </div>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="sidebar__logout-form">
            <button type="submit"
                    class="sidebar__logout"
                    data-confirm="Queres mesmo terminar a sessão?"
                    title="Sair"
                    aria-label="Terminar sessão">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </button>
        </form>
    </div>
</aside>

<div class="sidebar-backdrop" data-sidebar-backdrop></div>

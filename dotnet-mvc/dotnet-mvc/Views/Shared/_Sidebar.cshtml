@using System.Security.Claims
@using dotnet_mvc.Extensions
@using dotnet_mvc.Security

@*
    Partial da sidebar para áreas autenticadas
    Variáveis (via ViewData):
      - "Role": "Student" | "Professor" | "Admin"
      - "ActiveMenu": identificador da entrada ativa (ex: "dashboard")
      - "UserName" / "UserRoleLabel": opcional para o footer
*@
@{
    var currentRole = Context.User.FindFirstValue(ClaimTypes.Role);
    var role = (ViewData["Role"] as string) ?? UserRoles.Normalize(currentRole);
    var active = (ViewData["ActiveMenu"] as string) ?? "";
    var userName = Context.User.Identity?.IsAuthenticated == true
        ? Context.User.GetDisplayName()
        : (ViewData["UserName"] as string) ?? "Utilizador";
    var userRoleLabel = Context.User.Identity?.IsAuthenticated == true
        ? Context.User.GetRoleLabel()
        : (ViewData["UserRoleLabel"] as string) ?? UserRoles.ToDisplayLabel(role);

    string Cls(string id) => active == id
        ? "sidebar-menu-btn sidebar-menu-btn--active"
        : "sidebar-menu-btn";
}

<div class="sidebar-gap"></div>

<aside class="sidebar-container" data-sidebar>
    <div class="sidebar-inner">

        @* Header / Brand *@
        <div class="sidebar-header">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="sidebar-brand-logo">DEC</span>
                <div>
                    <div class="sidebar-brand-text">Dinheiro em Casa</div>
                    <div class="sidebar-brand-tag">ISTEC</div>
                </div>
            </a>
        </div>

        @* Navigation *@
        <div class="sidebar-content">

            @if (role == "Student")
            {
                @* Nav principal — sem label (shadcn/ui: primeiro grupo sem título) *@
                <div class="sidebar-group">
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a class="@Cls("dashboard")" asp-controller="Student" asp-action="Dashboard">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                <span>Dashboard</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-sep"></div>

                @* Ferramentas financeiras *@
                <div class="sidebar-group">
                    <span class="sidebar-group-label">Finanças</span>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a class="@Cls("scenarios")" asp-controller="Student" asp-action="Scenarios">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                <span>Cenários familiares</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("entries")" asp-controller="Student" asp-action="Entries">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                <span>Lançamentos</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("simulations")" asp-controller="Student" asp-action="Simulations">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                                <span>Simulações</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("objectives")" asp-controller="Student" asp-action="Objectives">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                                <span>Objetivos</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("calculator")" asp-controller="Student" asp-action="Calculator">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="12" y1="10" x2="14" y2="10"/><line x1="16" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="12" y1="14" x2="14" y2="14"/><line x1="16" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="10" y2="18"/><line x1="12" y1="18" x2="14" y2="18"/><line x1="16" y1="18" x2="16" y2="18"/></svg>
                                <span>Calculadora</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-sep"></div>

                @* Turma *@
                <div class="sidebar-group">
                    <span class="sidebar-group-label">Turma</span>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a class="@Cls("challenges")" asp-controller="Student" asp-action="Challenges">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                                <span>Desafios</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("join-code")" asp-controller="Student" asp-action="JoinCode">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 1 7.07 0l1.41 1.41a5 5 0 1 1-7.07 7.07L10 20"/><path d="M14 11a5 5 0 0 1-7.07 0L5.52 9.59A5 5 0 0 1 12.59 2.52L14 4"/><line x1="8" y1="16" x2="16" y2="8"/></svg>
                                <span>Aderir por código</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else if (role == "Professor")
            {
                @* Nav principal — sem label *@
                <div class="sidebar-group">
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a class="@Cls("dashboard")" asp-controller="Professor" asp-action="Dashboard">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("classes")" asp-controller="Professor" asp-action="Classes">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                <span>Turmas</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("challenges")" asp-controller="Professor" asp-action="Challenges">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                                <span>Desafios</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("submissions")" asp-controller="Professor" asp-action="Submissions">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                <span>Submissões</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("progress")" asp-controller="Professor" asp-action="Progress">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                <span>Progresso</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-sep"></div>

                @* Ações rápidas *@
                <div class="sidebar-group">
                    <span class="sidebar-group-label">Criar</span>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a class="@Cls("create-challenge")" asp-controller="Professor" asp-action="CreateChallenge">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                <span>Criar desafio</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("create-class")" asp-controller="Professor" asp-action="CreateClass">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                <span>Criar turma</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else if (role == "Admin")
            {
                @* Plataforma *@
                <div class="sidebar-group">
                    <span class="sidebar-group-label">Plataforma</span>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a class="@Cls("dashboard")" asp-controller="Admin" asp-action="Dashboard">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("users")" asp-controller="Admin" asp-action="Users">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                <span>Utilizadores</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("monitoring")" asp-controller="Admin" asp-action="Monitoring">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                                <span>Monitorização</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-sep"></div>

                @* Gestão académica *@
                <div class="sidebar-group">
                    <span class="sidebar-group-label">Académico</span>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a class="@Cls("classes")" asp-controller="Professor" asp-action="Classes">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                <span>Turmas</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("challenges")" asp-controller="Professor" asp-action="Challenges">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                                <span>Desafios</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("create-class")" asp-controller="Professor" asp-action="CreateClass">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                <span>Criar turma</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a class="@Cls("create-challenge")" asp-controller="Professor" asp-action="CreateChallenge">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                <span>Criar desafio</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

        </div>

        @* Footer / User *@
        <div class="sidebar-footer">
            <div class="sidebar-user-row">
                <span class="sidebar-avatar">@(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")</span>
                <div class="sidebar-user-info">
                    <span class="sidebar-user-name">@userName</span>
                    <span class="sidebar-user-role">@userRoleLabel</span>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="sidebar-logout-form">
                    <button type="submit"
                            class="sidebar-logout-btn"
                            data-confirm="Queres mesmo terminar a sessão?"
                            title="Sair"
                            aria-label="Terminar sessão">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

    </div>
</aside>

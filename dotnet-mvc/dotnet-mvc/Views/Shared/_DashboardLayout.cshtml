@*
    Layout das áreas autenticadas (Student, Professor, Admin)
    Lê de ViewData:
      - "Title": título do separador
      - "PageTitle": título mostrado na topbar
      - "Role": "Student" | "Professor" | "Admin"
      - "ActiveMenu": id do item ativo (ex: "dashboard")
      - "UserName" / "UserRoleLabel"
*@
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · DEC – Dinheiro em Casa</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="dashboard">

    @await Html.PartialAsync("_Sidebar")

    <div class="dashboard__main">

        <header class="topbar">
            <div class="topbar__left">
                <button class="topbar__toggle" type="button" data-sidebar-toggle aria-label="Abrir menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="3" y1="6"  x2="21" y2="6"  />
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>
                <h1 class="topbar__title">@ViewData["PageTitle"]</h1>
            </div>

            <div class="topbar__right">
                <button class="topbar__icon-btn" type="button" aria-label="Pesquisar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </button>
                <button class="topbar__icon-btn" type="button" aria-label="Notificações">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="topbar__notification-dot"></span>
                </button>
            </div>
        </header>

        <div class="dashboard__content fade-in">
            @RenderBody()
        </div>

    </div>
</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

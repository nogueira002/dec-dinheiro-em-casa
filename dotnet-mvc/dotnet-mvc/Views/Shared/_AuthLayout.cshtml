@*
    Layout de autenticação — split screen, sem navbar/footer
    Usar em Login, Register, ForgotPassword
*@
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · DEC – Dinheiro em Casa</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="auth">

    @* ── Painel esquerdo · branding ── *@
    <div class="auth-brand">
        <a class="ab-logo" asp-controller="Home" asp-action="Index" style="text-decoration:none;">
            <span class="ab-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 11a7 4 0 0 0-7-3.8C8 7.2 5 9 5 11.5c0 1.3.8 2.4 2 3.2V18h2.5l.5-1.4a10 10 0 0 0 4 0L14.5 18H17v-3.3c1.2-.8 2-2 2-3.2Z"/>
                    <path d="M5.5 10.5C4 10.2 3 9.4 3 8.5M9 7.2 8 5.5"/>
                </svg>
            </span>
            <span class="ab-name">DEC</span>
        </a>

        <div class="ab-hero">
            <h2>O dinheiro <span class="hl">começa em casa.</span></h2>
            <p>A plataforma onde aprendes a gerir, poupar e decidir — com cenários reais da tua família e da tua turma.</p>

            <div class="ab-card">
                <div class="abc-label">Saldo da simulação</div>
                <div class="abc-value">€347,80</div>
                <div class="abc-bars" id="ab-bars"></div>
            </div>

            <div class="ab-features">
                <div class="ab-feat">
                    <span class="afi">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h13"/><path d="m14 4 3 3-3 3"/><path d="M20 17H7"/><path d="m10 20-3-3 3-3"/></svg>
                    </span>
                    Regista receitas e despesas do dia a dia
                </div>
                <div class="ab-feat">
                    <span class="afi">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/></svg>
                    </span>
                    Define objetivos de poupança e acompanha-os
                </div>
                <div class="ab-feat">
                    <span class="afi">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2"/></svg>
                    </span>
                    Simula juros, créditos e decisões financeiras
                </div>
            </div>
        </div>

        <div class="ab-foot">
            <span>
                <svg style="display:inline;width:13px;height:13px;vertical-align:-2px;margin-right:4px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v6c0 4 3 7 7 8 4-1 7-4 7-8V6l-7-3Z"/></svg>
                Dados protegidos
            </span>
            <span>Literacia financeira · Ensino secundário</span>
        </div>
    </div>

    @* ── Painel direito · formulário ── *@
    <div class="auth-form-side">
        <div class="auth-card">
            @if (TempData["StatusMessage"] is string statusMessage)
            {
                var statusType = TempData["StatusType"] as string ?? "info";
                <div class="validation-summary-errors" style="@(statusType == "success" ? "background:var(--green-50);border-color:color-mix(in srgb,var(--green-500) 25%,transparent);color:var(--green-600);" : "")" role="alert">
                    @statusMessage
                </div>
            }

            @RenderBody()
        </div>
    </div>

</div>

<script>
  (function(){
    const h=[40,65,50,80,60,95,72];
    const el=document.getElementById('ab-bars');
    if(el) el.innerHTML=h.map(v=>`<i style="height:${v}%"></i>`).join('');
  })();
</script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@*
    Layout principal (público)
    DEC – Dinheiro em Casa · ISTEC
*@
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · DEC – Dinheiro em Casa</title>
    <meta name="description" content="DEC – Dinheiro em Casa: plataforma educativa de literacia financeira para alunos do ensino secundário." />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="app">

    <header>
        <nav class="navbar" role="navigation" aria-label="Navegação principal">
            <div class="navbar__container">
                <a class="navbar__brand" asp-controller="Home" asp-action="Index">
                    <span class="navbar__logo" aria-hidden="true">DEC</span>
                    <span>Dinheiro em Casa</span>
                </a>

                <button class="navbar__toggle"
                        type="button"
                        data-nav-toggle
                        aria-expanded="false"
                        aria-label="Abrir menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="3" y1="6"  x2="21" y2="6"  />
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>

                <div class="navbar__menu" data-nav-menu>
                    <a class="navbar__link" asp-controller="Home" asp-action="Index">Início</a>
                    <a class="navbar__link" href="#funcionalidades">Funcionalidades</a>
                    <a class="navbar__link" href="#sobre">Sobre o projeto</a>

                    <div class="navbar__actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn--ghost btn--sm" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                            }
                            else if (User.IsInRole("Professor"))
                            {
                                <a class="btn btn--ghost btn--sm" asp-controller="Professor" asp-action="Dashboard">Dashboard</a>
                            }
                            else
                            {
                                <a class="btn btn--ghost btn--sm" asp-controller="Student" asp-action="Dashboard">Dashboard</a>
                            }

                            <form asp-controller="Auth" asp-action="Logout" method="post" class="inline-form">
                                <button type="submit" class="btn btn--primary btn--sm">Sair</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn--ghost btn--sm" asp-controller="Auth" asp-action="Login">Entrar</a>
                            <a class="btn btn--primary btn--sm" asp-controller="Auth" asp-action="Register">Criar conta</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="app__main" role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer__container">
            <div class="footer__brand">
                <span class="navbar__logo" aria-hidden="true">DEC</span>
                <div>
                    <div>Dinheiro em Casa</div>
                    <div class="text-sm text-muted fw-normal">ISTEC · Literacia Financeira</div>
                </div>
            </div>

            <div class="footer__links">
                <a class="footer__link" asp-controller="Home" asp-action="Index">Início</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Admin"))
                    {
                        <a class="footer__link" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                    }
                    else if (User.IsInRole("Professor"))
                    {
                        <a class="footer__link" asp-controller="Professor" asp-action="Dashboard">Dashboard</a>
                    }
                    else
                    {
                        <a class="footer__link" asp-controller="Student" asp-action="Dashboard">Dashboard</a>
                    }
                }
                else
                {
                    <a class="footer__link" asp-controller="Auth" asp-action="Login">Entrar</a>
                    <a class="footer__link" asp-controller="Auth" asp-action="Register">Registo</a>
                }
                <a class="footer__link" asp-controller="Home" asp-action="Privacy">Privacidade</a>
            </div>

            <div class="footer__copyright">
                &copy; @DateTime.Now.Year DEC – Dinheiro em Casa · ISTEC. Todos os direitos reservados.
            </div>
        </div>
    </footer>

</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
